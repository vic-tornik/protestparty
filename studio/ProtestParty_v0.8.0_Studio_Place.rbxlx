    <Item class="ServerScriptService">
      <Properties>
        <string name="Name">ServerScriptService</string>
      </Properties>
      <Item class="Folder">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">DebateCommunityService</string>
            <ProtectedString name="Source">--!strict
-- Community debate topics. All user text is filtered on the server before any broadcast.
-- Public proposals are server-local and expire with the server; private rooms use short-lived codes.
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("GameConfig"))
local GlobalDebateService = require(script.Parent:WaitForChild("GlobalDebateService"))
local WeeklyChampionshipService = require(script.Parent:WaitForChild("WeeklyChampionshipService"))
local SocialSystemsService = require(script.Parent:WaitForChild("SocialSystemsService"))

local Service = {}
local stateRemote: RemoteEvent
local communityRemote: RemoteEvent
local publicQueue: {any} = {}
local lastSubmit: {[number]: number} = {}
local lastPrivateCreate: {[number]: number} = {}
local lastVoteRequest: {[number]: number} = {}
local lastReportRequest: {[number]: number} = {}
local lastPrivateVoteRequest: {[number]: number} = {}
local lastWeeklyRequest: {[number]: number} = {}
local lastTournamentRequest: {[number]: number} = {}
local lastRefreshRequest: {[number]: number} = {}
local lastModerateRequest: {[number]: number} = {}
local reports: {[string]: {[number]: boolean}} = {}
local rooms: {[string]: any} = {}
local playerRoom: {[number]: string} = {}
local MAX_QUEUE = 20
local ALLOWED_CATEGORIES = {Everyday=true, Technology=true, Factions=true, Wildcard=true}
local MAX_TOPIC_LENGTH = 100
local MIN_TOPIC_LENGTH = 12
local SUBMIT_COOLDOWN = 75
local ROOM_SECONDS = 50

local function validPlayer(player: Player): boolean
	return player.Parent == Players and player:GetAttribute("ProfileLoaded") == true
end

local function cleanTopic(input: any): string?
	if type(input) ~= "string" then return nil end
	local topic = string.gsub(input, "[%c]", " ")
	topic = string.gsub(topic, "%s+", " ")
	topic = string.gsub(topic, "^%s*(.-)%s*$", "%1")
	if #topic &lt; MIN_TOPIC_LENGTH or #topic &gt; MAX_TOPIC_LENGTH then return nil end
	return topic
end

local function filterForBroadcast(player: Player, raw: string): string?
	local ok, result = pcall(function()
		local filterResult = TextService:FilterStringAsync(raw, player.UserId, Enum.TextFilterContext.PublicChat)
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)
	if not ok or type(result) ~= "string" or result == "" then return nil end
	if string.find(result, "#", 1, true) then return nil end
	return result
end

local function cleanCategory(player: Player, rawCategory: any): string?
	if type(rawCategory) ~= "string" then return "Everyday" end
	local category = string.gsub(rawCategory, "%s+", " ")
	category = string.gsub(category, "^%s*(.-)%s*$", "%1")
	if ALLOWED_CATEGORIES[category] then return category end
	if #category &lt; 3 or #category &gt; 18 or not string.match(category, "^[%w%s]+$") then return nil end
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(category, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok or type(filtered) ~= "string" or filtered == "" or string.find(filtered, "#", 1, true) then return nil end
	return filtered
end

local function publicSnapshot()
	local globalTopics = GlobalDebateService.GetTrending()
	if #globalTopics &gt; 0 then return globalTopics end
	local list = {}
	for i, item in ipairs(publicQueue) do
		if i &gt; 8 then break end
		table.insert(list, {id=item.id, topic=item.topic, category=item.category or "Everyday", votes=item.votes, creator=item.creator})
	end
	return list
end

local function broadcastPublic(message: string?)
	stateRemote:FireAllClients({kind="CommunityDebates", publicTopics=publicSnapshot(), notice=message})
end

local function removePublicTopic(topicId: string)
	for i, item in ipairs(publicQueue) do
		if item.id == topicId then table.remove(publicQueue, i); reports[topicId] = nil; break end
	end
end

local function createPublic(player: Player, raw: any, rawCategory: any)
	if not validPlayer(player) then return end
	local now = os.clock()
	if now - (lastSubmit[player.UserId] or 0) &lt; SUBMIT_COOLDOWN then
		stateRemote:FireClient(player, {kind="CommunityNotice", text="Please wait before proposing another topic."}); return
	end
	lastSubmit[player.UserId] = now
	if #publicQueue &gt;= MAX_QUEUE then
		stateRemote:FireClient(player, {kind="CommunityNotice", text="The public topic queue is full. Try again after a debate."}); return
	end
	local clean = cleanTopic(raw)
	if not clean then
		stateRemote:FireClient(player, {kind="CommunityNotice", text="Topics must be 12–100 characters."}); return
	end
	local filtered = filterForBroadcast(player, clean)
	if not filtered then
		stateRemote:FireClient(player, {kind="CommunityNotice", text="Roblox could not approve that topic. Please rephrase it."}); return
	end
	local normalized = string.lower(filtered)
	for _, item in ipairs(publicQueue) do
		if string.lower(item.topic) == normalized then
			stateRemote:FireClient(player, {kind="CommunityNotice", text="That topic is already in the public queue."}); return
		end
	end
	local category = cleanCategory(player, rawCategory)
	if not category then stateRemote:FireClient(player,{kind="CommunityNotice",text="Categories must be 3–18 safe letters/numbers. Rephrase if Roblox filtering rejects it."}); return end
	local globalOk, globalError = GlobalDebateService.Submit(filtered, category, player.UserId, player.DisplayName)
	if not globalOk and (globalError == "duplicate" or globalError == "global_cooldown") then
		stateRemote:FireClient(player,{kind="CommunityNotice",text=if globalError == "duplicate" then "That topic already exists in the global debate feed." else "Global submission cooldown active. Please wait before trying again."})
		return
	end
	-- Keep a local fallback only for infrastructure failures; never bypass a global rate limit.
	if not globalOk then
		table.insert(publicQueue, {id=HttpService:GenerateGUID(false), topic=filtered, category=category, votes=0, voterIds={}, creator=player.DisplayName, createdAt=os.time()})
	end
	broadcastPublic(if globalOk then "Topic published to the global debate network." else "Global network unavailable; topic is queued in this server only.")
	stateRemote:FireClient(player, {kind="CommunityNotice", text=if globalOk then "Your topic entered the global debate network!" else "Global network unavailable. Your topic is queued locally."})
end

local function createPrivate(player: Player, raw: any)
	if not validPlayer(player) then return end
	if os.clock()-(lastPrivateCreate[player.UserId] or 0)&lt;20 then stateRemote:FireClient(player,{kind="CommunityNotice",text="Wait before creating another private room."}); return end
	lastPrivateCreate[player.UserId]=os.clock()
	local roomCount=0; for _ in pairs(rooms) do roomCount+=1 end
	if roomCount&gt;=20 then stateRemote:FireClient(player,{kind="CommunityNotice",text="Private debate capacity is full. Try again shortly."}); return end
	local clean = cleanTopic(raw)
	if not clean then stateRemote:FireClient(player,{kind="CommunityNotice",text="Topics must be 12–100 characters."}); return end
	local filtered = filterForBroadcast(player, clean)
	if not filtered then stateRemote:FireClient(player,{kind="CommunityNotice",text="Roblox could not approve that topic. Please rephrase it."}); return end
	if playerRoom[player.UserId] then stateRemote:FireClient(player,{kind="CommunityNotice",text="Leave your current private debate first."}); return end
	local code = string.upper(string.sub(string.gsub(HttpService:GenerateGUID(false), "-", ""), 1, 6))
	while rooms[code] do code=string.upper(string.sub(string.gsub(HttpService:GenerateGUID(false), "-", ""), 1, 6)) end
	rooms[code] = {code=code, topic=filtered, host=player.UserId, members={[player.UserId]=true}, votes={}, createdAt=os.clock(), endsAt=os.clock()+ROOM_SECONDS, closed=false}
	playerRoom[player.UserId] = code
	stateRemote:FireClient(player,{kind="PrivateDebate",code=code,topic=filtered,endsAt=workspace:GetServerTimeNow()+ROOM_SECONDS,counts={A=0,B=0},host=true})
	task.delay(ROOM_SECONDS, function()
		local room = rooms[code]
		if not room or room.closed then return end
		room.closed = true
		local a,b=0,0; for _,side in pairs(room.votes) do if side=="A" then a+=1 elseif side=="B" then b+=1 end end
		for userId in pairs(room.members) do
			local member=Players:GetPlayerByUserId(userId)
			if member then stateRemote:FireClient(member,{kind="PrivateDebateResult",topic=room.topic,a=a,b=b,winner=if a&gt;b then "A" elseif b&gt;a then "B" else "TIE"}) end
			playerRoom[userId]=nil
		end
		rooms[code]=nil
	end)
end

local function joinPrivate(player: Player, rawCode: any)
	if not validPlayer(player) or type(rawCode)~="string" then return end
	local code=string.upper(string.gsub(rawCode,"%s+",""))
	if #code~=6 or playerRoom[player.UserId] then stateRemote:FireClient(player,{kind="CommunityNotice",text="Invalid code or you are already in a private debate."}); return end
	local room=rooms[code]
	if not room or room.closed or os.clock()&gt;=room.endsAt then stateRemote:FireClient(player,{kind="CommunityNotice",text="That private debate has ended or does not exist."}); return end
	local memberCount=0; for _ in pairs(room.members) do memberCount+=1 end
	if memberCount&gt;=8 then stateRemote:FireClient(player,{kind="CommunityNotice",text="Private debates are limited to eight players."}); return end
	room.members[player.UserId]=true; playerRoom[player.UserId]=code
	local a,b=0,0; for _,side in pairs(room.votes) do if side=="A" then a+=1 elseif side=="B" then b+=1 end end
	stateRemote:FireClient(player,{kind="PrivateDebate",code=code,topic=room.topic,endsAt=workspace:GetServerTimeNow()+math.max(0,room.endsAt-os.clock()),counts={A=a,B=b},host=false})
end

local function privateVote(player: Player, code: any, side: any)
	if not validPlayer(player) or type(code)~="string" or (side~="A" and side~="B") then return end
	local now = os.clock(); if now-(lastPrivateVoteRequest[player.UserId] or 0)&lt;0.35 then return end; lastPrivateVoteRequest[player.UserId]=now
	local room=rooms[code]
	if not room or room.closed or not room.members[player.UserId] or os.clock()&gt;=room.endsAt then return end
	room.votes[player.UserId]=side
	local a,b=0,0; for _,v in pairs(room.votes) do if v=="A" then a+=1 elseif v=="B" then b+=1 end end
	for userId in pairs(room.members) do local member=Players:GetPlayerByUserId(userId); if member then stateRemote:FireClient(member,{kind="PrivateDebateCounts",a=a,b=b}) end end
end

local function voteTopic(player: Player, topicId: any)
	if not validPlayer(player) or type(topicId)~="string" then return end
	local now = os.clock(); if now-(lastVoteRequest[player.UserId] or 0)&lt;0.5 then return end; lastVoteRequest[player.UserId]=now
	if string.sub(topicId, 1, 6) == "topic_" then
		if GlobalDebateService.Vote(topicId, player.UserId) then broadcastPublic("Global topic support updated across servers.") end
		return
	end
	for _,item in ipairs(publicQueue) do
		if item.id==topicId then
			item.voterIds=item.voterIds or {}
			if not item.voterIds[player.UserId] then item.voterIds[player.UserId]=true; item.votes+=1; broadcastPublic("A public topic received an audience vote.") end
			return
		end
	end
end

local function reportTopic(player: Player, topicId: any)
	if not validPlayer(player) or type(topicId)~="string" then return end
	local now = os.clock(); if now-(lastReportRequest[player.UserId] or 0)&lt;1 then return end; lastReportRequest[player.UserId]=now
	if string.sub(topicId, 1, 6) == "topic_" then
		local accepted, count = GlobalDebateService.Report(topicId, player.UserId)
		stateRemote:FireClient(player,{kind="CommunityNotice",text=if accepted then "Global report received. A moderator can review the topic." else "You have already reported this topic or the report service is unavailable."})
		if count &gt;= 3 then broadcastPublic("A global topic has reached the moderation review threshold.") end
		return
	end
	local found=false
	for _,item in ipairs(publicQueue) do if item.id==topicId then found=true break end end
	if not found then return end
	reports[topicId]=reports[topicId] or {}
	if reports[topicId][player.UserId] then return end
	reports[topicId][player.UserId]=true
	local count=0; for _ in pairs(reports[topicId]) do count+=1 end
	if count&gt;=3 then removePublicTopic(topicId); broadcastPublic("A topic was removed after multiple player reports.") end
	stateRemote:FireClient(player,{kind="CommunityNotice",text="Report received. Reports are reviewed by the server moderation threshold."})
end

function Service.GetNextPublicTopic(): any?
	local globalPick = GlobalDebateService.GetNextFeaturedOrTrending()
	if globalPick then return globalPick end
	if #publicQueue==0 then return nil end
	table.sort(publicQueue,function(a,b) return a.votes&gt;b.votes end)
	local selected=table.remove(publicQueue,1)
	broadcastPublic("A community topic was selected for the next public debate.")
	return {id="community_"..selected.id,prompt=selected.topic,sideA="SUPPORT THE MOTION",sideB="OPPOSE THE MOTION",context="Community-submitted topic. Debate the idea, never the person."}
end


local function isModerator(player: Player): boolean
	for _, userId in ipairs(Config.ModeratorUserIds or {}) do
		if userId == player.UserId then return true end
	end
	return false
end

local function moderateTopic(player: Player, topicId: any, action: any)
	if not validPlayer(player) or not isModerator(player) or type(topicId) ~= "string" or type(action) ~= "string" then return end
	local now = os.clock(); if now-(lastModerateRequest[player.UserId] or 0)&lt;1 then return end; lastModerateRequest[player.UserId]=now
	if GlobalDebateService.Moderate(topicId, action, player.UserId) then
		stateRemote:FireClient(player, {kind="CommunityNotice", text="Moderation action applied: " .. action})
		broadcastPublic("The global debate board was updated by moderation.")
	else
		stateRemote:FireClient(player, {kind="CommunityNotice", text="Moderation action failed. Refresh and try again."})
	end
end

function Service.Start(remote: RemoteEvent, state: RemoteEvent)
	communityRemote=remote; stateRemote=state
	GlobalDebateService.Start(function() broadcastPublic("Global debate topics refreshed across servers.") end)
	communityRemote.OnServerEvent:Connect(function(player, action, value, extra)
		if type(action)~="string" then return end
		if action=="CreatePublic" then createPublic(player,value,extra)
		elseif action=="CreatePrivate" then createPrivate(player,value)
		elseif action=="JoinPrivate" then joinPrivate(player,value)
		elseif action=="PrivateVote" then privateVote(player,value,extra)
		elseif action=="ReportTopic" then reportTopic(player,value)
		elseif action=="VoteTopic" then voteTopic(player,value)
		elseif action=="ModerateTopic" then moderateTopic(player,value,extra)
		elseif action=="VoteFeatured" then
            if not validPlayer(player) or type(value)~="string" then return end
            local now=os.clock(); if now-(lastVoteRequest[player.UserId] or 0)&lt;1 then return end; lastVoteRequest[player.UserId]=now
            local accepted,count=GlobalDebateService.VoteFeatured(value,player.UserId)
            stateRemote:FireClient(player,{kind="CommunityNotice",text=if accepted then "Community feature vote recorded · "..tostring(count).." votes" else "You already voted or the feature-vote service is unavailable."})
            if count&gt;=5 then broadcastPublic("A topic has reached the community feature threshold and is eligible for moderator approval.") end
        elseif action=="GetModerationQueue" then
            if not validPlayer(player) or not isModerator(player) then return end
            local now=os.clock(); if now-(lastModerateRequest[player.UserId] or 0)&lt;2 then return end; lastModerateRequest[player.UserId]=now
            stateRemote:FireClient(player,{kind="ModerationQueue",items=GlobalDebateService.GetReviewQueue()})
        elseif action=="GetModerationAudit" then
            if not validPlayer(player) or not isModerator(player) or type(value)~="string" then return end
            local now=os.clock(); if now-(lastModerateRequest[player.UserId] or 0)&lt;2 then return end; lastModerateRequest[player.UserId]=now
            stateRemote:FireClient(player,{kind="ModerationAudit",topicId=value,entries=GlobalDebateService.GetAudit(value)})
		elseif action=="RefreshGlobal" then
			if not validPlayer(player) then return end
			local now=os.clock(); if now-(lastRefreshRequest[player.UserId] or 0)&lt;8 then return end; lastRefreshRequest[player.UserId]=now
			stateRemote:FireClient(player,{kind="CommunityDebates",publicTopics=publicSnapshot(),notice="GLOBAL DEBATE NETWORK · LIVE DISCOVERY"})
		elseif action=="GetTournament" then
            if not validPlayer(player) then return end
            local now=os.clock(); if now-(lastTournamentRequest[player.UserId] or 0)&lt;5 then return end; lastTournamentRequest[player.UserId]=now
            stateRemote:FireClient(player,{kind="FactionWar",data=SocialSystemsService.GetWarState()})
		elseif action=="GetWeekly" then
			if not validPlayer(player) then return end
			local now=os.clock(); if now-(lastWeeklyRequest[player.UserId] or 0)&lt;30 then return end; lastWeeklyRequest[player.UserId]=now
			stateRemote:FireClient(player,{kind="WeeklyChampionship",data=WeeklyChampionshipService.GetTop()})
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		task.delay(2,function() if player.Parent==Players then stateRemote:FireClient(player,{kind="CommunityDebates",publicTopics=publicSnapshot()}) end end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastSubmit[player.UserId]=nil
		lastPrivateCreate[player.UserId]=nil
		lastVoteRequest[player.UserId]=nil
		lastReportRequest[player.UserId]=nil
		lastPrivateVoteRequest[player.UserId]=nil
		lastWeeklyRequest[player.UserId]=nil
		lastTournamentRequest[player.UserId]=nil
		lastRefreshRequest[player.UserId]=nil
		lastModerateRequest[player.UserId]=nil
		local code=playerRoom[player.UserId]
		if code and rooms[code] then rooms[code].members[player.UserId]=nil; rooms[code].votes[player.UserId]=nil end
		playerRoom[player.UserId]=nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		if isModerator(player) then stateRemote:FireClient(player,{kind="ModeratorAccess",enabled=true}) end
	end
	Players.PlayerAdded:Connect(function(player)
		task.delay(3,function() if player.Parent==Players and isModerator(player) then stateRemote:FireClient(player,{kind="ModeratorAccess",enabled=true}) end end)
	end)
	broadcastPublic("Global debate network online. Discover topics submitted across servers.")
end
return Service
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">GlobalDebateService</string>
            <ProtectedString name="Source">--!strict
-- Cross-server community debate index. MemoryStore is ephemeral by design; durable player
-- reputation remains in ProfileService. All calls fail closed when platform services throttle.
local MemoryStoreService = game:GetService("MemoryStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")

local GlobalDebateService = {}
local TOPIC_TTL = 60 * 60 * 24 * 3
local MAX_FEED = 12
local TOPIC_PREFIX = "topic_"
local TOPIC_MAP = MemoryStoreService:GetSortedMap("PP_GlobalDebates_v1")
local REVIEW_MAP = MemoryStoreService:GetSortedMap("PP_DebateModerationReview_v1")
local FEATURE_VOTE_MAP = MemoryStoreService:GetHashMap("PP_DebateFeaturedVotes_v1")
local DataStoreService = game:GetService("DataStoreService")
local AUDIT_STORE = DataStoreService:GetDataStore("PP_DebateModerationAudit_v1")
local REPORT_MAP = MemoryStoreService:GetHashMap("PP_GlobalDebateReports_v1")
local TOPIC_CHANNEL = "PP_GlobalDebates_Refresh_v1"
local refreshCallback: (() -&gt; ())? = nil
local subscribed = false

local function publishRefresh()
	pcall(function()
		MessagingService:PublishAsync(TOPIC_CHANNEL, {at = os.time(), job = game.JobId})
	end)
end

function GlobalDebateService.Start(onRefresh: () -&gt; ())
	refreshCallback = onRefresh
	if subscribed then return end
	subscribed = true
	local ok, connectionOrError = pcall(function()
		return MessagingService:SubscribeAsync(TOPIC_CHANNEL, function(message)
			local data = message.Data
			if type(data) == "table" and data.job ~= game.JobId and refreshCallback then
				task.spawn(refreshCallback)
			end
		end)
	end)
	if not ok then
		warn("[GlobalDebateService] Cross-server notifications unavailable: " .. tostring(connectionOrError))
	end
end

function GlobalDebateService.Submit(topic: string, category: string, creatorId: number, creatorName: string): (boolean, string?)
	local rateToken = HttpService:GenerateGUID(false)
	local rateOk, rateRecord = pcall(function()
		return REPORT_MAP:UpdateAsync("submit_" .. tostring(creatorId), function(old)
			if type(old) == "table" and os.time() - (tonumber(old.at) or 0) &lt; 75 then return old end
			return {at = os.time(), token = rateToken}
		end, 90)
	end)
	if not rateOk or type(rateRecord) ~= "table" or rateRecord.token ~= rateToken then return false, "global_cooldown" end
	local normalized = string.lower(topic)
	for _, existing in ipairs(GlobalDebateService.GetTrending()) do
		if string.lower(tostring(existing.topic)) == normalized then return false, "duplicate" end
	end
	local id = TOPIC_PREFIX .. HttpService:GenerateGUID(false)
	local record = {
		id = id, topic = topic, category = category, creatorId = creatorId,
		creator = string.sub(creatorName, 1, 32), votes = 0, status = "pending",
		createdAt = os.time(), serverId = game.JobId,
	}
	local ok, err = pcall(function()
		TOPIC_MAP:SetAsync(id, record, TOPIC_TTL, record.createdAt)
	end)
	if not ok then return false, tostring(err) end
	publishRefresh()
	return true, id
end

function GlobalDebateService.GetTrending(): {any}
	local ok, rows = pcall(function()
		return TOPIC_MAP:GetRangeAsync(Enum.SortDirection.Descending, MAX_FEED)
	end)
	if not ok or type(rows) ~= "table" then return {} end
	local result = {}
	for _, row in ipairs(rows) do
		local value = row.value
		if type(value) == "table" and (value.status == "pending" or value.status == "featured") then
			table.insert(result, {
				id = value.id, topic = value.topic, category = value.category,
				votes = tonumber(value.votes) or 0, creator = value.creator,
				reports = tonumber(value.reports) or 0, featured = value.status == "featured", communityApproved = value.communityApproved == true, featureVotes = tonumber(value.featureVotes) or 0, createdAt = value.createdAt,
			})
		end
	end
	table.sort(result, function(a, b)
		if a.featured ~= b.featured then return a.featured end
        if a.communityApproved ~= b.communityApproved then return a.communityApproved end
		if a.votes ~= b.votes then return a.votes &gt; b.votes end
		return (a.createdAt or 0) &gt; (b.createdAt or 0)
	end)
	return result
end

function GlobalDebateService.Vote(topicId: string, userId: number): boolean
	if #topicId &gt; 80 or string.sub(topicId, 1, #TOPIC_PREFIX) ~= TOPIC_PREFIX then return false end
	local voterKey = "voted_" .. tostring(userId) .. "_" .. topicId
	local markerToken = HttpService:GenerateGUID(false)
	local ok, didVote = pcall(function()
		local marker = REPORT_MAP:UpdateAsync(voterKey, function(old)
			if old ~= nil then return old end
			return markerToken
		end, TOPIC_TTL)
		if marker ~= markerToken then return false end
		local updated = TOPIC_MAP:UpdateAsync(topicId, function(old, sortKey)
			if type(old) ~= "table" or (old.status ~= "pending" and old.status ~= "featured") then return nil end
			old.votes = math.min(1000000, (tonumber(old.votes) or 0) + 1)
			local featuredOffset = if old.status == "featured" then 1e15 else 0
			return old, featuredOffset + old.votes * 1e8 + (tonumber(old.createdAt) or 0)
		end, TOPIC_TTL)
		return updated ~= nil
	end)
	if ok and didVote then publishRefresh() end
	return ok and didVote == true
end

function GlobalDebateService.Report(topicId: string, userId: number): (boolean, number)
	if #topicId &gt; 80 or string.sub(topicId, 1, #TOPIC_PREFIX) ~= TOPIC_PREFIX then return false, 0 end
    local initialOk, initialTopic = pcall(function() return TOPIC_MAP:GetAsync(topicId) end)
    if not initialOk or type(initialTopic) ~= "table" or (initialTopic.status ~= "pending" and initialTopic.status ~= "featured") then return false, 0 end
	local reportKey = "report_" .. tostring(userId) .. "_" .. topicId
	local markerToken = HttpService:GenerateGUID(false)
	local ok, count = pcall(function()
		local marker = REPORT_MAP:UpdateAsync(reportKey, function(old)
			if old ~= nil then return old end
			return markerToken
		end, TOPIC_TTL)
		if marker ~= markerToken then return -1 end
		local total = REPORT_MAP:UpdateAsync("count_" .. topicId, function(old)
			return math.min(10000, (tonumber(old) or 0) + 1)
		end, TOPIC_TTL)
		local reportCount = tonumber(total) or 0
		local topic = TOPIC_MAP:UpdateAsync(topicId, function(old, sortKey)
			if type(old) ~= "table" or (old.status ~= "pending" and old.status ~= "featured") then return nil end
			old.reports = reportCount
			return old, sortKey
		end, TOPIC_TTL)
        if reportCount &gt;= 3 and type(topic) == "table" then
            REVIEW_MAP:SetAsync(topicId, {id=topicId, topic=topic.topic, category=topic.category, reports=reportCount, createdAt=topic.createdAt, status=topic.status}, TOPIC_TTL, reportCount * 1e8 + os.time())
        end
		return reportCount
	end)
	if not ok then return false, 0 end
	return count ~= -1, math.max(0, count)
end

function GlobalDebateService.VoteFeatured(topicId: string, userId: number): (boolean, number)
 if #topicId &gt; 80 or string.sub(topicId, 1, #TOPIC_PREFIX) ~= TOPIC_PREFIX then return false, 0 end
 local topicOk, topicRecord = pcall(function() return TOPIC_MAP:GetAsync(topicId) end)
 if not topicOk or type(topicRecord) ~= "table" or topicRecord.status ~= "pending" then return false, 0 end
 local markerKey = "featured_" .. tostring(userId) .. "_" .. topicId
 local token = HttpService:GenerateGUID(false)
 local ok, count = pcall(function()
  local marker = FEATURE_VOTE_MAP:UpdateAsync(markerKey, function(old) if old ~= nil then return old end return token end, TOPIC_TTL)
  if marker ~= token then return -1 end
  local total = FEATURE_VOTE_MAP:UpdateAsync("count_" .. topicId, function(old) return math.min(100000, (tonumber(old) or 0) + 1) end, TOPIC_TTL)
  return tonumber(total) or 0
 end)
 if not ok then return false, 0 end
 local votes = math.max(0, count)
 if votes &gt;= 5 then
  pcall(function() TOPIC_MAP:UpdateAsync(topicId, function(old, sortKey)
   if type(old) ~= "table" or old.status ~= "pending" then return old, sortKey end
   old.communityApproved = true; old.featureVotes = votes
   return old, (tonumber(old.votes) or 0) * 1e8 + (tonumber(old.createdAt) or 0)
  end, TOPIC_TTL) end)
 end
 publishRefresh()
 return count ~= -1, votes
end

function GlobalDebateService.GetReviewQueue(): {any}
 local ok, rows = pcall(function() return REVIEW_MAP:GetRangeAsync(Enum.SortDirection.Descending, 30) end)
 if not ok or type(rows) ~= "table" then return {} end
 local result = {}
 for _, row in ipairs(rows) do
  local value = row.value
  if type(value) == "table" then table.insert(result, {id=value.id, topic=value.topic, category=value.category, reports=tonumber(value.reports) or 0, createdAt=value.createdAt, status=value.status}) end
 end
 return result
end

local function appendAudit(topicId: string, actorId: number, action: string, previousStatus: string, nextStatus: string): boolean
 local entry = {actorId=actorId, action=action, previousStatus=previousStatus, nextStatus=nextStatus, at=os.time()}
 local ok, err = pcall(function()
  AUDIT_STORE:UpdateAsync("topic_" .. topicId, function(old)
   local history = if type(old) == "table" then old else {}
   table.insert(history, entry)
   while #history &gt; 50 do table.remove(history, 1) end
   return history
  end)
 end)
 if not ok then warn("[GlobalDebateService] Audit write failed: " .. tostring(err)) end
 return ok
end

function GlobalDebateService.GetAudit(topicId: string): {any}
 if #topicId &gt; 80 then return {} end
 local ok, value = pcall(function() return AUDIT_STORE:GetAsync("topic_" .. topicId) end)
 return if ok and type(value) == "table" then value else {}
end

function GlobalDebateService.Moderate(topicId: string, action: string, actorId: number): boolean
 if #topicId &gt; 80 or string.sub(topicId, 1, #TOPIC_PREFIX) ~= TOPIC_PREFIX then return false end
 if action ~= "Feature" and action ~= "Remove" and action ~= "Restore" then return false end
 if action == "Feature" then
  local topicOk, topicRecord = pcall(function() return TOPIC_MAP:GetAsync(topicId) end)
  if not topicOk or type(topicRecord) ~= "table" or topicRecord.communityApproved ~= true then return false end
  local featuredCount = 0
  for _, item in ipairs(GlobalDebateService.GetTrending()) do if item.featured then featuredCount += 1 end end
  if featuredCount &gt;= 3 then return false end
 end
 local nextStatus = if action == "Feature" then "featured" elseif action == "Remove" then "removed" else "pending"
 local previousStatus = "unknown"
 local ok, updated = pcall(function()
  return TOPIC_MAP:UpdateAsync(topicId, function(old, sortKey)
   if type(old) ~= "table" then return nil end
   previousStatus = tostring(old.status or "unknown")
   old.status = nextStatus
   if nextStatus == "removed" then return old, -1e15 end
   local featuredOffset = if nextStatus == "featured" then 1e15 else 0
   return old, featuredOffset + (tonumber(old.votes) or 0) * 1e8 + (tonumber(old.createdAt) or 0)
  end, TOPIC_TTL)
 end)
 if not ok or updated == nil then return false end
 if not appendAudit(topicId, actorId, action, previousStatus, nextStatus) then
  warn("[GlobalDebateService] Moderation state changed but audit persistence failed for " .. topicId)
 end
 pcall(function() REVIEW_MAP:RemoveAsync(topicId) end)
 publishRefresh(); return true
end

function GlobalDebateService.GetNextFeaturedOrTrending(): any?
	local topics = GlobalDebateService.GetTrending()
	for pass = 1, 2 do
		for _, item in ipairs(topics) do
			if (pass == 1 and item.featured) or (pass == 2 and not item.featured) then
				local ok, claimed = pcall(function()
					return TOPIC_MAP:UpdateAsync(item.id, function(old, sortKey)
						if type(old) ~= "table" or (old.status ~= "pending" and old.status ~= "featured") then return nil end
						old.status = "used"
						old.usedAt = os.time()
						return old, 0
					end, TOPIC_TTL)
				end)
				if ok and type(claimed) == "table" and claimed.status == "used" then
					publishRefresh()
					return {id = claimed.id, prompt = claimed.topic, sideA = "SUPPORT THE MOTION", sideB = "OPPOSE THE MOTION", context = if item.featured then "Community featured debate. Debate the idea, never the person." else "Global community debate. Debate the idea, never the person."}
				end
			end
		end
	end
	return nil
end

return GlobalDebateService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">PartyService</string>
            <ProtectedString name="Source">--!strict
-- Server-authoritative same-server social parties. Party state is ephemeral; no profile schema change.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local PartyService = {}
local MAX_MEMBERS = 6
local INVITE_TTL = 45
local parties: {[string]: any} = {}
local membership: {[number]: string} = {}
local invites: {[number]: {[number]: number}} = {}
local requestAt: {[number]: number} = {}
local inviteAt: {[number]: number} = {}
local remote: RemoteEvent
local function partyFor(player: Player): any? local id=membership[player.UserId]; return if id then parties[id] else nil end
local function snapshot(party: any): any
 local members={}; for userId in pairs(party.members) do local p=Players:GetPlayerByUserId(userId); if p then table.insert(members,{userId=userId,name=p.DisplayName,isLeader=userId==party.leader}) end end
 table.sort(members,function(a,b) if a.isLeader then return true elseif b.isLeader then return false end return a.name&lt;b.name end)
 return {partyId=party.id,clubId=party.clubId,leader=party.leader,members=members,maxMembers=MAX_MEMBERS}
end
local function push(party: any)
 local data=snapshot(party); for userId in pairs(party.members) do local p=Players:GetPlayerByUserId(userId); if p then remote:FireClient(p,"PartyState",data) end end
end
local function allowed(player: Player): boolean
 if player.Parent~=Players or player:GetAttribute("ProfileLoaded")~=true then return false end
 local now=os.clock(); if now-(requestAt[player.UserId] or 0)&lt;0.35 then return false end; requestAt[player.UserId]=now; return true
end
function PartyService.GetPartySnapshot(player: Player): any?
 local party=partyFor(player)
 return if party then snapshot(party) else nil
end
function PartyService.GetPartyMembers(player: Player): {number}
 local party=partyFor(player); local ids={}
 if party then for userId in pairs(party.members) do table.insert(ids,userId) end end
 return ids
end
local function removeMember(party: any,userId: number)
 party.members[userId]=nil; membership[userId]=nil
 local count=0; for _ in pairs(party.members) do count+=1 end
 if count==0 then parties[party.id]=nil
 elseif party.leader==userId then for nextId in pairs(party.members) do party.leader=nextId; break end end
 if parties[party.id] then push(party) end
end
function PartyService.Start(partyRemote: RemoteEvent)
 remote=partyRemote
 remote.OnServerEvent:Connect(function(player,action,targetUserId)
  if type(action)~="string" or not allowed(player) then return end
  if action=="Create" then
   if partyFor(player) then return end
   local id="party_"..HttpService:GenerateGUID(false)
   local party={id=id,clubId="club_"..tostring(player.UserId),leader=player.UserId,members={[player.UserId]=true},createdAt=os.time()}; parties[id]=party; membership[player.UserId]=id; push(party)
  elseif action=="Invite" then
   local party=partyFor(player); if not party or party.leader~=player.UserId or type(targetUserId)~="string" or #targetUserId&lt;2 or #targetUserId&gt;32 then return end
   if os.clock()-(inviteAt[player.UserId] or 0)&lt;5 then remote:FireClient(player,"PartyNotice","Wait before sending another invite."); return end
   inviteAt[player.UserId]=os.clock()
   local target: Player? = nil; local query=string.lower(targetUserId)
   for _,candidate in ipairs(Players:GetPlayers()) do if candidate~=player and (string.lower(candidate.Name)==query or string.lower(candidate.DisplayName)==query) then target=candidate; break end end
   if not target or partyFor(target) then return end
   local count=0; for _ in pairs(party.members) do count+=1 end; if count&gt;=MAX_MEMBERS then return end
   invites[target.UserId]=invites[target.UserId] or {}; invites[target.UserId][player.UserId]=os.time()+INVITE_TTL
   remote:FireClient(target,"PartyInvite",{fromUserId=player.UserId,fromName=player.DisplayName,expiresAt=os.time()+INVITE_TTL})
   remote:FireClient(player,"PartyNotice","Invite sent to "..target.DisplayName..".")
  elseif action=="Accept" then
   if type(targetUserId)~="number" or partyFor(player) then return end
   local inviter=math.floor(targetUserId); local expiry=invites[player.UserId] and invites[player.UserId][inviter]
   if not expiry or expiry&lt;os.time() then return end
   invites[player.UserId][inviter]=nil
   local inviterPlayer=Players:GetPlayerByUserId(inviter); local party=if inviterPlayer then partyFor(inviterPlayer) else nil
   if not party then return end
   local count=0; for _ in pairs(party.members) do count+=1 end; if count&gt;=MAX_MEMBERS then return end
   party.members[player.UserId]=true; membership[player.UserId]=party.id; push(party)
  elseif action=="Leave" then
   local party=partyFor(player); if party then removeMember(party,player.UserId); remote:FireClient(player,"PartyState",nil) end
  elseif action=="Kick" then
   local party=partyFor(player); if not party or party.leader~=player.UserId or type(targetUserId)~="string" then return end
   local query=string.lower(targetUserId); local targetId=nil
   for memberId in pairs(party.members) do local member=Players:GetPlayerByUserId(memberId); if member and memberId~=player.UserId and (string.lower(member.Name)==query or string.lower(member.DisplayName)==query) then targetId=memberId; break end end
   if not targetId then return end
   local target=Players:GetPlayerByUserId(targetId); removeMember(party,targetId); if target then remote:FireClient(target,"PartyState",nil); remote:FireClient(target,"PartyNotice","You were removed from the party.") end
  elseif action=="Get" then
   local party=partyFor(player); remote:FireClient(player,"PartyState",if party then snapshot(party) else nil)
  end
 end)
 Players.PlayerRemoving:Connect(function(player)
  local party=partyFor(player); if party then removeMember(party,player.UserId) end
  membership[player.UserId]=nil; invites[player.UserId]=nil; requestAt[player.UserId]=nil; inviteAt[player.UserId]=nil
  for _,byInviter in pairs(invites) do byInviter[player.UserId]=nil end
 end)
end
return PartyService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">ProfileService</string>
            <ProtectedString name="Source">--!strict
-- Server-only player profiles with session locking, schema migration, retries, and safe shutdown.
-- Never rename the LIVE data store or change the User_&lt;UserId&gt; key pattern for routine updates.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local ProfileService = {}

local CURRENT_SCHEMA = GameConfig.ProfileSchemaVersion
local STORE_NAME = if RunService:IsStudio() then GameConfig.DataStoreNameStudio else GameConfig.DataStoreNameLive
local Store = DataStoreService:GetDataStore(STORE_NAME)
local SESSION_ID = if game.JobId ~= "" then game.JobId else ("studio:" .. HttpService:GenerateGUID(false))

local sessions: {[number]: any} = {}
local loadInProgress: {[number]: boolean} = {}

local DEFAULT_DATA = {
	Coins = 0,
	XP = 0,
	Level = 1,
	OwnedCosmetics = { basic_sign = true },
	EquippedCosmetic = "basic_sign",
	Stats = {
		RoundsPlayed = 0,
		TotalHype = 0,
		Chants = 0,
        DebatesJoined = 0,
        DailyClaims = 0,
        FactionJoins = 0,
        DebateReputation = 0,
        DebateWins = 0,
	},
	Daily = { date = "", challengeId = "", progress = 0, claimed = false },
	Settings = {
		MusicEnabled = true,
		EffectsEnabled = true,
	},
	_meta = {
		schemaVersion = CURRENT_SCHEMA,
		sessionId = nil,
		leaseExpiresAt = 0,
		updatedAt = 0,
		revision = 0,
	},
}

local ALLOWED_STATS = {
	RoundsPlayed = true,
	TotalHype = true,
	Chants = true,
    DebatesJoined = true,
    DailyClaims = true,
    FactionJoins = true,
    DebateReputation = true,
    DebateWins = true,
}

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in pairs(value) do
		copy[key] = deepCopy(child)
	end
	return copy
end

local function safeNonNegativeInteger(value: any, fallback: number): number
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return math.clamp(math.floor(value), 0, 1_000_000_000)
end

local function makeDefaultProfile(): any
	return deepCopy(DEFAULT_DATA)
end

local function migrateAndNormalize(raw: any): (any?, string?)
	if type(raw) ~= "table" then
		return nil, "corrupt_profile"
	end

	local data = deepCopy(raw)
	local meta = if type(data._meta) == "table" then data._meta else {}
	local schemaVersion = safeNonNegativeInteger(meta.schemaVersion, 0)

	if schemaVersion &gt; CURRENT_SCHEMA then
		return nil, "future_schema"
	end

	-- Version 0 is the original unversioned shape. Keep recognized values and add defaults.
	while schemaVersion &lt; CURRENT_SCHEMA do
		if schemaVersion == 0 then
			if data.Coins == nil and data.Money ~= nil then data.Coins = data.Money end
			data.Money = nil
			schemaVersion = 1
		elseif schemaVersion == 1 then
            -- v0.3 additive migration: preserve all existing balances, inventory and stats.
            if type(data.Daily) ~= "table" then data.Daily = {date="", challengeId="", progress=0, claimed=false} end
            schemaVersion = 2
        elseif schemaVersion == 2 then
            -- v0.5 additive migration: debate standing is separate from spendable currency.
            if type(data.Stats) ~= "table" then data.Stats = {} end
            if data.Stats.DebateReputation == nil then data.Stats.DebateReputation = 0 end
            if data.Stats.DebateWins == nil then data.Stats.DebateWins = 0 end
            schemaVersion = 3
		else return nil, "missing_migration" end
	end

	local defaults = makeDefaultProfile()
	data.Coins = safeNonNegativeInteger(data.Coins, defaults.Coins)
	data.XP = safeNonNegativeInteger(data.XP, defaults.XP)
	data.Level = math.max(1, safeNonNegativeInteger(data.Level, defaults.Level))

	if type(data.OwnedCosmetics) ~= "table" then
		data.OwnedCosmetics = defaults.OwnedCosmetics
	end
	data.OwnedCosmetics.basic_sign = true
	if type(data.EquippedCosmetic) ~= "string" or not data.OwnedCosmetics[data.EquippedCosmetic] then
		data.EquippedCosmetic = defaults.EquippedCosmetic
	end

	if type(data.Stats) ~= "table" then data.Stats = {} end
	for statName, _ in pairs(ALLOWED_STATS) do
		data.Stats[statName] = safeNonNegativeInteger(data.Stats[statName], 0)
	end

    if type(data.Daily) ~= "table" then data.Daily = {} end
    if type(data.Daily.date) ~= "string" then data.Daily.date = "" end
    if type(data.Daily.challengeId) ~= "string" then data.Daily.challengeId = "" end
    data.Daily.progress = safeNonNegativeInteger(data.Daily.progress, 0)
    if type(data.Daily.claimed) ~= "boolean" then data.Daily.claimed = false end
	if type(data.Settings) ~= "table" then data.Settings = {} end
	if type(data.Settings.MusicEnabled) ~= "boolean" then data.Settings.MusicEnabled = true end
	if type(data.Settings.EffectsEnabled) ~= "boolean" then data.Settings.EffectsEnabled = true end

	data._meta = {
		schemaVersion = CURRENT_SCHEMA,
		sessionId = meta.sessionId,
		leaseExpiresAt = safeNonNegativeInteger(meta.leaseExpiresAt, 0),
		updatedAt = safeNonNegativeInteger(meta.updatedAt, 0),
		revision = safeNonNegativeInteger(meta.revision, 0),
	}
	return data, nil
end

local function keyFor(player: Player): string
	return "User_" .. tostring(player.UserId)
end

local function updateLeaderstats(player: Player, data: any)
	player:SetAttribute("ProfileLoaded", true)
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("Level", data.Level)

	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end
	local coins = leaderstats:FindFirstChild("Coins") :: IntValue?
	if not coins then
		coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Parent = leaderstats
	end
	coins.Value = data.Coins
	local level = leaderstats:FindFirstChild("Level") :: IntValue?
	if not level then
		level = Instance.new("IntValue")
		level.Name = "Level"
		level.Parent = leaderstats
	end
	level.Value = data.Level
end

local function backoff(attempt: number)
	local delaySeconds = math.min(8, 2 ^ math.max(0, attempt - 1))
	task.wait(delaySeconds + (math.random() * 0.35))
end

function ProfileService.IsLoaded(player: Player): boolean
	return sessions[player.UserId] ~= nil and player:GetAttribute("ProfileLoaded") == true
end

function ProfileService.GetData(player: Player): any?
	local session = sessions[player.UserId]
	if not session or session.lost then return nil end
	return session.data
end

function ProfileService.Load(player: Player): (boolean, string?)
	local userId = player.UserId
	if sessions[userId] then return true, nil end
	if loadInProgress[userId] then
		local waitStarted = os.clock()
		while loadInProgress[userId] and not sessions[userId] and (os.clock() - waitStarted) &lt; (GameConfig.ProfileLoadTimeoutSeconds + 5) do
			task.wait(0.1)
		end
		if sessions[userId] then return true, nil end
		return false, "load_failed"
	end
	loadInProgress[userId] = true

	local startedAt = os.clock()
	local attempt = 0
	local finalReason: string? = nil

	while player.Parent == Players and (os.clock() - startedAt) &lt; GameConfig.ProfileLoadTimeoutSeconds do
		attempt += 1
		local callbackReason: string? = nil
		local now = os.time()
		local success, result = pcall(function()
			return Store:UpdateAsync(keyFor(player), function(oldValue)
				local data
				if oldValue == nil then
					data = makeDefaultProfile()
				else
					local migrationError
					data, migrationError = migrateAndNormalize(oldValue)
					if not data then
						callbackReason = migrationError or "invalid_profile"
						return nil
					end
				end

				local meta = data._meta
				local currentOwner = meta.sessionId
				local leaseExpiresAt = tonumber(meta.leaseExpiresAt) or 0
				if currentOwner and currentOwner ~= SESSION_ID and leaseExpiresAt &gt; now then
					callbackReason = "session_locked"
					return nil
				end

				meta.sessionId = SESSION_ID
				meta.leaseExpiresAt = now + GameConfig.ProfileLockSeconds
				meta.updatedAt = now
				return data
			end)
		end)

		if success and type(result) == "table" and type(result._meta) == "table" and result._meta.sessionId == SESSION_ID then
			if player.Parent ~= Players then
				-- The player left while the DataStore request yielded. Release only this session's lease.
				pcall(function()
					Store:UpdateAsync(keyFor(player), function(oldValue)
						if type(oldValue) ~= "table" or type(oldValue._meta) ~= "table" or oldValue._meta.sessionId ~= SESSION_ID then return nil end
						local released = deepCopy(oldValue)
						released._meta.sessionId = nil
						released._meta.leaseExpiresAt = 0
						return released
					end)
				end)
				loadInProgress[userId] = nil
				return false, "player_left"
			end
			local normalized, reason = migrateAndNormalize(result)
			if normalized then
				sessions[userId] = {
					data = normalized,
					busy = false,
					lost = false,
					lastSaveAt = os.clock(),
				}
				updateLeaderstats(player, normalized)
				loadInProgress[userId] = nil
				return true, nil
			end
			finalReason = reason
		elseif callbackReason == "future_schema" or callbackReason == "corrupt_profile" or callbackReason == "missing_migration" then
			finalReason = callbackReason
			break
		elseif callbackReason == "session_locked" then
			finalReason = "session_locked"
		elseif not success then
			finalReason = "datastore_unavailable"
			warn(string.format("[ProfileService] Load attempt %d failed for %d: %s", attempt, userId, tostring(result)))
		else
			finalReason = callbackReason or "profile_not_acquired"
		end

		backoff(attempt)
	end

	loadInProgress[userId] = nil
	if finalReason == "future_schema" or finalReason == "corrupt_profile" or finalReason == "missing_migration" then
		warn(string.format("[ProfileService] Refusing unsafe profile load for %d (%s). No default overwrite attempted.", userId, finalReason))
	end
	return false, finalReason or "load_timeout"
end

local function saveInternal(player: Player, releaseLock: boolean): boolean
	local userId = player.UserId
	local session = sessions[userId]
	if not session or session.lost then return false end

	local waitStarted = os.clock()
	while session.busy and (os.clock() - waitStarted) &lt; 8 do
		task.wait(0.1)
	end
	-- Another save may have released and removed this session while we waited.
	if sessions[userId] ~= session or session.lost then return false end
	if session.busy then return false end
	session.busy = true

	local snapshot = deepCopy(session.data)
	local attempt = 0
	local saved = false
	local lockLost = false
	local errorText: string? = nil

	while attempt &lt; GameConfig.ProfileMaxSaveRetries and not saved do
		attempt += 1
		lockLost = false
		local success, result = pcall(function()
			return Store:UpdateAsync(keyFor(player), function(oldValue)
				if type(oldValue) ~= "table" or type(oldValue._meta) ~= "table" then
					lockLost = true
					return nil
				end
				if oldValue._meta.sessionId ~= SESSION_ID then
					lockLost = true
					return nil
				end

				local oldRevision = safeNonNegativeInteger(oldValue._meta.revision, 0)
				snapshot._meta = {
					schemaVersion = CURRENT_SCHEMA,
					sessionId = if releaseLock then nil else SESSION_ID,
					leaseExpiresAt = if releaseLock then 0 else (os.time() + GameConfig.ProfileLockSeconds),
					updatedAt = os.time(),
					revision = oldRevision + 1,
				}
				return snapshot
			end)
		end)

		if success and type(result) == "table" then
			saved = true
			session.lastSaveAt = os.clock()
		else
			errorText = tostring(result)
			if lockLost then break end
			if not success then warn(string.format("[ProfileService] Save attempt %d failed for %d: %s", attempt, userId, errorText)) end
			if attempt &lt; GameConfig.ProfileMaxSaveRetries then backoff(attempt) end
		end
	end

	session.busy = false
	if lockLost then
		session.lost = true
		warn(string.format("[ProfileService] Session lock lost for %d. Refusing further writes.", userId))
		if player.Parent == Players then
			player:Kick("Your data session changed. Please rejoin so your progress stays safe.")
		end
		return false
	end

	if saved and releaseLock then
		sessions[userId] = nil
	elseif not saved then
		warn(string.format("[ProfileService] Could not safely save %d. The lock will expire rather than risk overwriting another session. %s", userId, errorText or ""))
	end
	return saved
end

function ProfileService.Save(player: Player, releaseLock: boolean?): boolean
	return saveInternal(player, releaseLock == true)
end

function ProfileService.AddCoins(player: Player, amount: number): number
	local data = ProfileService.GetData(player)
	if not data or type(amount) ~= "number" or amount &lt;= 0 or amount ~= amount then return 0 end
	local granted = math.min(math.floor(amount), GameConfig.Rewards.MaxCoins - data.Coins)
	if granted &lt;= 0 then return 0 end
	data.Coins += granted
	updateLeaderstats(player, data)
	return granted
end

function ProfileService.AddXP(player: Player, amount: number): number
	local data = ProfileService.GetData(player)
	if not data or type(amount) ~= "number" or amount &lt;= 0 or amount ~= amount then return 0 end
	local granted = math.min(math.floor(amount), GameConfig.Rewards.MaxXP - data.XP)
	if granted &lt;= 0 then return 0 end
	data.XP += granted
	data.Level = math.floor(data.XP / 100) + 1
	updateLeaderstats(player, data)
	return granted
end

function ProfileService.IncrementStat(player: Player, statName: string, amount: number)
	local data = ProfileService.GetData(player)
	if not data or not ALLOWED_STATS[statName] then return end
	if type(amount) ~= "number" or amount &lt;= 0 or amount ~= amount then return end
	data.Stats[statName] = math.min(1_000_000_000, data.Stats[statName] + math.floor(amount))
end

function ProfileService.AddDebateReputation(player: Player, amount: number): number
    local data = ProfileService.GetData(player)
    if not data or type(amount) ~= "number" or amount &lt;= 0 or amount ~= amount or amount == math.huge then return 0 end
    local current = safeNonNegativeInteger(data.Stats.DebateReputation, 0)
    data.Stats.DebateReputation = math.clamp(current + math.floor(amount), 0, 1_000_000_000)
    updateLeaderstats(player, data)
    return data.Stats.DebateReputation
end


function ProfileService.PurchaseCosmetic(player: Player, cosmeticId: string, price: number): (boolean, string)
 local data = ProfileService.GetData(player)
 if not data or type(cosmeticId) ~= "string" or #cosmeticId &gt; 48 then return false, "profile_unavailable" end
 if data.OwnedCosmetics[cosmeticId] then data.EquippedCosmetic = cosmeticId; return true, "equipped" end
 if type(price) ~= "number" or price &lt; 0 or price &gt; GameConfig.Shop.MaxPrice or price % 1 ~= 0 then return false, "invalid_price" end
 if data.Coins &lt; price then return false, "not_enough_coins" end
 data.Coins -= price
 data.OwnedCosmetics[cosmeticId] = true
 data.EquippedCosmetic = cosmeticId
 updateLeaderstats(player, data)
 return true, "purchased"
end

function ProfileService.EquipCosmetic(player: Player, cosmeticId: string): boolean
 local data = ProfileService.GetData(player)
 if not data or type(cosmeticId) ~= "string" or not data.OwnedCosmetics[cosmeticId] then return false end
 data.EquippedCosmetic = cosmeticId
 return true
end

function ProfileService.GetDaily(player: Player, challengeId: string, utcDate: string): any?
 local data = ProfileService.GetData(player)
 if not data then return nil end
 if data.Daily.date ~= utcDate then
  data.Daily = {date=utcDate, challengeId=challengeId, progress=0, claimed=false}
 elseif data.Daily.challengeId == "" then data.Daily.challengeId = challengeId end
 return data.Daily
end

function ProfileService.ProgressDaily(player: Player, kind: string, amount: number, challengeId: string, utcDate: string): (number, boolean)
 local daily = ProfileService.GetDaily(player, challengeId, utcDate)
 if not daily or daily.claimed or type(amount) ~= "number" or amount &lt;= 0 then return 0, false end
 if daily.challengeId ~= challengeId then return daily.progress, false end
 daily.progress = math.min(100000, daily.progress + math.floor(amount))
 return daily.progress, true
end

function ProfileService.ClaimDaily(player: Player, challengeId: string, utcDate: string, target: number, coins: number, xp: number): (boolean, string)
 local data = ProfileService.GetData(player)
 if not data then return false, "profile_unavailable" end
 local daily = ProfileService.GetDaily(player, challengeId, utcDate)
 if not daily or daily.claimed or daily.progress &lt; target then return false, "not_complete" end
 daily.claimed = true
 ProfileService.AddCoins(player, coins)
 ProfileService.AddXP(player, xp)
 ProfileService.IncrementStat(player, "DailyClaims", 1)
 return true, "claimed"
end

function ProfileService.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(GameConfig.ProfileAutosaveSeconds + math.random(0, 8))
			for _, player in ipairs(Players:GetPlayers()) do
				if sessions[player.UserId] then
					task.spawn(function()
						-- Spread writes across a short jitter window to avoid synchronized server bursts.
						task.wait(math.random() * 12)
						if player.Parent == Players and sessions[player.UserId] then
							saveInternal(player, false)
						end
					end)
				end
			end
		end
	end)
end

function ProfileService.ReleaseAll()
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if sessions[player.UserId] then
			pending += 1
			task.spawn(function()
				saveInternal(player, true)
				pending -= 1
			end)
		end
	end
	local deadline = os.clock() + 25
	while pending &gt; 0 and os.clock() &lt; deadline do
		task.wait(0.1)
	end
end

return ProfileService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">RoundService</string>
            <ProtectedString name="Source">--!strict
-- Server-authoritative round, town-hall, shop, faction and daily challenge orchestration.
local Players=game:GetService("Players")
local Workspace=game:GetService("Workspace")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Shared=ReplicatedStorage:WaitForChild("Shared")
local Config=require(Shared:WaitForChild("GameConfig"))
local Catalog=require(Shared:WaitForChild("ContentCatalog"))
local WorldBuilder=require(script.Parent:WaitForChild("WorldBuilder"))
local DebateCommunityService=require(script.Parent:WaitForChild("DebateCommunityService"))
local WeeklyChampionshipService=require(script.Parent:WaitForChild("WeeklyChampionshipService"))
local RoundService={}
local Profiles: any; local StateRemote: RemoteEvent; local VoteRemote: RemoteEvent; local DebateRemote: RemoteEvent
local state: any={phase="Starting",endsAt=Workspace:GetServerTimeNow()+5}
local options={}; local cause:any=nil; local debate:any=nil
local votes:{[number]:string}={}; local debateVotes:{[number]:string}={}; local hallVotes:{[number]:string}={}; local reactionScores:{[number]:number}={}; local reactionCounts:any={clap=0,laugh=0,sideeye=0}
local hype:{[number]:number}={}; local chantActions:{[number]:number}={}; local lastChant:{[number]:number}={}; local requestAt:{[any]:number}={}
local worldData:any
local activeTownHallRule:any=nil
local factionAlliance:{[string]:string}={}
local allianceNames:{[string]:string}={}
local random=Random.new()
local function now() return Workspace:GetServerTimeNow() end
local function utcDate() return os.date("!%Y-%m-%d") end
local function dailyChallenge(): any
 local day=os.date("!*t").yday
 return Catalog.DailyChallenges[((day-1)%#Catalog.DailyChallenges)+1]
end
local function dailyPayload(player: Player): any
 local d=dailyChallenge(); local profile=Profiles.GetDaily(player,d.id,utcDate())
 return {id=d.id,title=d.title,detail=d.detail,target=d.target,progress=profile and profile.progress or 0,claimed=profile and profile.claimed or false,coins=d.coins,xp=d.xp}
end
local function countMap(source:any, allowed:{string}):any
 local counts={}; for _,id in ipairs(allowed) do counts[id]=0 end
 for _,value in pairs(source) do if counts[value]~=nil then counts[value]+=1 end end
 return counts
end
local function hallCounts() return countMap(hallVotes,{"A","B","C"}) end
local function sendProfile(player: Player)
 local data=Profiles.GetData(player); if not data then return end
 StateRemote:FireClient(player,{kind="Profile",coins=data.Coins,xp=data.XP,level=data.Level,daily=dailyPayload(player),equipped=data.EquippedCosmetic,owned=data.OwnedCosmetics})
 StateRemote:FireClient(player,state)
end
local function publish(phase:string,duration:number,extra:any?)
 state={kind="Phase",phase=phase,endsAt=now()+duration,season=Catalog.GetSeason().name,cause=if cause then {id=cause.id,title=cause.title,shortTitle=cause.shortTitle} else nil}
 if type(extra)=="table" then for k,v in pairs(extra) do state[k]=v end end
 StateRemote:FireAllClients(state)
end
local function validPlayer(player:Player):boolean return player.Parent==Players and Profiles.IsLoaded(player) end
local function proximity(player:Player, instance:Instance, maxDistance:number):boolean
 local char=player.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
 return root~=nil and root:IsA("BasePart") and instance:IsA("BasePart") and (root.Position-instance.Position).Magnitude&lt;=maxDistance
end
local function dailyProgress(player:Player,kind:string,amount:number)
 local d=dailyChallenge(); if d.kind~=kind then return end
 local progress,changed=Profiles.ProgressDaily(player,kind,amount,d.id,utcDate())
 if changed then StateRemote:FireClient(player,{kind="DailyProgress",daily=dailyPayload(player)}) end
end
local function onCauseVote(player:Player,id:any)
 if state.phase~="Voting" or not validPlayer(player) or type(id)~="string" or #id&gt;48 then return end
 local t=os.clock(); if requestAt[player.UserId] and t-requestAt[player.UserId]&lt;.35 then return end; requestAt[player.UserId]=t
 for _,item in ipairs(options) do if item.id==id then votes[player.UserId]=id; state.voteCounts=countMap(votes,(function() local a={} for _,o in ipairs(options) do table.insert(a,o.id) end return a end)()); StateRemote:FireAllClients(state); return end end
end
local function onDebateVote(player:Player,side:any)
 if state.phase~="Debate" or not validPlayer(player) or (side~="A" and side~="B") then return end
 local t=os.clock(); if requestAt[player.UserId] and t-requestAt[player.UserId]&lt;.45 then return end; requestAt[player.UserId]=t
 debateVotes[player.UserId]=side; state.debateCounts=countMap(debateVotes,{"A","B"}); StateRemote:FireAllClients(state)
end
local function onTownHallVote(player:Player,side:string)
 if state.phase~="TownHall" or not validPlayer(player) or (side~="A" and side~="B" and side~="C") then return end
 local t=os.clock(); if requestAt[player.UserId] and t-requestAt[player.UserId]&lt;.5 then return end; requestAt[player.UserId]=t
 hallVotes[player.UserId]=side; state.townHallCounts=hallCounts(); StateRemote:FireAllClients(state)
end
local function createAlliances(): any
 local ids={}; for _,f in ipairs(Catalog.Factions) do table.insert(ids,f.id) end
 for i=#ids,2,-1 do local j=random:NextInteger(1,i); ids[i],ids[j]=ids[j],ids[i] end
 factionAlliance={A="A",B="A",C="B",D="B"}; allianceNames={A="THE CRUMB COALITION",B="THE PAPERWORK PACT"}
 factionAlliance[ids[1]]="A"; factionAlliance[ids[2]]="A"; factionAlliance[ids[3]]="B"; factionAlliance[ids[4]]="B"
 return {{id="A",name=allianceNames.A,factions={ids[1],ids[2]}},{id="B",name=allianceNames.B,factions={ids[3],ids[4]}}}
end

local function chooseCause():any
 local counts={}; for _,o in ipairs(options) do counts[o.id]=0 end
 for _,id in pairs(votes) do if counts[id]~=nil then counts[id]+=1 end end
 local max=-1; local leaders={}
 for _,o in ipairs(options) do local n=counts[o.id] or 0; if n&gt;max then max=n; leaders={o} elseif n==max then table.insert(leaders,o) end end
 return leaders[random:NextInteger(1,#leaders)]
end
local function chooseDebateWinner():string
 local c=countMap(debateVotes,{"A","B"}); return if c.A&gt;c.B then "A" elseif c.B&gt;c.A then "B" else "TIE"
end
local function chooseDebateMVP(winner:string): (string, number?)
 local best=0; local candidates={}
 for _,p in ipairs(Players:GetPlayers()) do
  local side=debateVotes[p.UserId]; local score=reactionScores[p.UserId] or 0
  if score&gt;0 and (winner=="TIE" or side==winner) then
   local candidate={name=p.DisplayName,userId=p.UserId}
   if score&gt;best then best=score; candidates={candidate} elseif score==best then table.insert(candidates,candidate) end
  end
 end
 if #candidates==0 then return "No audience MVP",nil end
 local selected=candidates[random:NextInteger(1,#candidates)]
 return selected.name,selected.userId
end
local function onDebateReaction(player:Player,reactionId:string,promptObj:ProximityPrompt)
 if state.phase~="Debate" or not validPlayer(player) or not proximity(player,promptObj.Parent,14) then return end
 if reactionId~="clap" and reactionId~="laugh" and reactionId~="sideeye" then return end
 local t=os.clock(); local key="reaction_"..player.UserId
 if requestAt[key] and t-requestAt[key]&lt;1.25 then return end
 if (reactionScores[player.UserId] or 0)&gt;=3 then return end
 requestAt[key]=t; reactionScores[player.UserId]=(reactionScores[player.UserId] or 0)+1
 reactionCounts[reactionId]+=1; state.debateReactions=table.clone(reactionCounts); StateRemote:FireAllClients(state)
end
local function rewardParticipants(debateWinner: string, debateMVPUserId: number?)
 local results={}; local factionTotals={}; local allianceTotals={}
 for _,p in ipairs(Players:GetPlayers()) do
  local n=hype[p.UserId] or 0; local debated=debateVotes[p.UserId]~=nil
  if validPlayer(p) and (n&gt;0 or debated) then
   local coins=(if n&gt;0 then Config.Rewards.ParticipationCoins+n*Config.Rewards.CoinsPerHype else 0)+(if debated then Config.Rewards.DebateCoins else 0)
   local factionWarPoints=n
   local xp=(if n&gt;0 then Config.Rewards.ParticipationXP+n*Config.Rewards.XPPerHype else 0)+(if debated then Config.Rewards.DebateXP else 0)
   local gotC=Profiles.AddCoins(p,coins); local gotX=Profiles.AddXP(p,xp)
   if n&gt;0 then Profiles.IncrementStat(p,"RoundsPlayed",1); Profiles.IncrementStat(p,"TotalHype",n); Profiles.IncrementStat(p,"Chants",n); dailyProgress(p,"rounds",1); dailyProgress(p,"chants",chantActions[p.UserId] or 0) end
   if debated then
    Profiles.IncrementStat(p,"DebatesJoined",1); dailyProgress(p,"debates",1)
    local reputation=3
    if debateWinner~="TIE" and debateVotes[p.UserId]==debateWinner then reputation+=2; Profiles.IncrementStat(p,"DebateWins",1) end
    Profiles.AddDebateReputation(p,reputation)
    local weeklyPoints = 3 + (if debateWinner~="TIE" and debateVotes[p.UserId]==debateWinner then 2 else 0) + (if p.UserId==debateMVPUserId then 3 else 0)
    factionWarPoints+=weeklyPoints
    WeeklyChampionshipService.Award(p,weeklyPoints)
   end
   local faction=p:GetAttribute("FactionId"); if type(faction)=="string" then
    factionTotals[faction]=(factionTotals[faction] or 0)+factionWarPoints
    local alliance=factionAlliance[faction]; if alliance then allianceTotals[alliance]=(allianceTotals[alliance] or 0)+n end
   end
   StateRemote:FireClient(p,{kind="Reward",coins=gotC,xp=gotX,hype=n,debateReputation=(Profiles.GetData(p) and Profiles.GetData(p).Stats.DebateReputation) or 0})
   table.insert(results,{userId=p.UserId,hype=n,coins=gotC})
  end
 end
 table.sort(results,function(a,b) return a.hype&gt;b.hype end)
 local leader="No faction reached quorum"; local high=0
 for id,total in pairs(factionTotals) do if total&gt;high then high=total; local f=Catalog.GetFaction(id); leader=f and f.name or id end end
 local allianceLeader="No coalition reached quorum"; high=0
 for id,total in pairs(allianceTotals) do if total&gt;high then high=total; allianceLeader=allianceNames[id] or id end end
 return results,leader,allianceLeader,factionTotals
end
local function applyCosmetic(player:Player, cosmeticId:string)
 local character=player.Character; if not character then return end
 local old=character:FindFirstChild("PP_Cosmetic"); if old then old:Destroy() end
 local oldTrail=character:FindFirstChild("PP_InkTrailAttachment",true); if oldTrail then oldTrail:Destroy() end
 local folder=Instance.new("Folder"); folder.Name="PP_Cosmetic"; folder.Parent=character
 local head=character:FindFirstChild("Head")
 local torso=character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
 local hand=character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
 local left=character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
 local function attach(base:Instance?,name:string,size:Vector3,offset:CFrame,color:Color3,material:Enum.Material?)
  if not base or not base:IsA("BasePart") then return end
  local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Color=color; p.Material=material or Enum.Material.SmoothPlastic; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true; p.CFrame=base.CFrame*offset; p.Parent=folder
  local weld=Instance.new("WeldConstraint"); weld.Part0=base; weld.Part1=p; weld.Parent=p
 end
 if cosmeticId=="pigeon_hat" then attach(head,"TinyPigeonHat",Vector3.new(1.7,.45,1.2),CFrame.new(0,1.05,0),Color3.fromRGB(150,150,160))
 elseif cosmeticId=="paper_crown" then
  attach(head,"PaperCrown",Vector3.new(1.8,.3,1.4),CFrame.new(0,1.02,0),Color3.fromRGB(245,204,85),Enum.Material.Metal)
  for i=-1,1 do attach(head,"CrownPoint"..i,Vector3.new(.22,.65,.25),CFrame.new(i*.52,1.4,0),Color3.fromRGB(255,222,110),Enum.Material.Metal) end
 elseif cosmeticId=="neon_megaphone" then attach(hand,"NeonMegaphone",Vector3.new(.55,1.1,.55),CFrame.new(0,-.1,-.45),GameConfig.UI.Accent,Enum.Material.Neon)
 elseif cosmeticId=="rainbow_banner" then attach(torso,"SpectrumBanner",Vector3.new(1.7,2.2,.18),CFrame.new(0,.1,.75),GameConfig.UI.Secondary,Enum.Material.Neon)
 elseif cosmeticId=="tiny_gavel" then attach(hand,"TinyGavel",Vector3.new(.35,.9,.35),CFrame.new(0,0,-.35),Color3.fromRGB(165,112,72),Enum.Material.Wood)
 elseif cosmeticId=="ink_trail" and torso and torso:IsA("BasePart") then
  local a=Instance.new("Attachment"); a.Name="PP_InkTrailAttachment"; a.Parent=torso
  local emitter=Instance.new("ParticleEmitter"); emitter.Name="InkTrail"; emitter.Texture="rbxasset://textures/particles/sparkles_main.dds"; emitter.Rate=3; emitter.Lifetime=NumberRange.new(.4,.8); emitter.Speed=NumberRange.new(.2,.8); emitter.Parent=a
 elseif cosmeticId=="dramatic_pose" and head and head:IsA("BasePart") then
  local gui=Instance.new("BillboardGui"); gui.Name="MainCharacterBadge"; gui.Size=UDim2.fromOffset(150,34); gui.StudsOffset=Vector3.new(0,2.5,0); gui.AlwaysOnTop=true; gui.Parent=folder
  local text=Instance.new("TextLabel"); text.Size=UDim2.fromScale(1,1); text.BackgroundTransparency=1; text.Text="✦ MAIN CHARACTER ✦"; text.TextColor3=GameConfig.UI.Accent; text.Font=Enum.Font.GothamBlack; text.TextScaled=true; text.Parent=gui; gui.Adornee=head
 elseif cosmeticId=="basic_sign" then attach(left,"CardboardPlacard",Vector3.new(1.1,1.4,.12),CFrame.new(0,.35,-.55),Color3.fromRGB(190,160,110),Enum.Material.Wood)
 end
 player:SetAttribute("EquippedCosmetic",cosmeticId)
end

local function handleShop(player:Player,itemId:string,promptObj:ProximityPrompt)
 if not validPlayer(player) or not proximity(player,promptObj.Parent,15) then return end
 local t=os.clock(); local key="shop_"..player.UserId; if requestAt[key] and t-requestAt[key]&lt;1 then return end; requestAt[key]=t
 local item=Catalog.GetCosmetic(itemId); if not item then return end
 local ok,status=Profiles.PurchaseCosmetic(player,item.id,item.price)
 local data=Profiles.GetData(player)
 if ok and data then applyCosmetic(player,data.EquippedCosmetic) end
 StateRemote:FireClient(player,{kind="ShopResult",ok=ok,status=status,item=item.name,coins=data and data.Coins or 0,equipped=data and data.EquippedCosmetic or "basic_sign",owned=data and data.OwnedCosmetics or {}})
end
local function handleFaction(player:Player,factionId:string,promptObj:ProximityPrompt)
 if not validPlayer(player) or not proximity(player,promptObj.Parent,15) then return end
 local t=os.clock(); local key="faction_"..player.UserId; if requestAt[key] and t-requestAt[key]&lt;2 then return end; requestAt[key]=t
 local f=Catalog.GetFaction(factionId); if not f then return end
 local old=player:GetAttribute("FactionId"); if old~=factionId then player:SetAttribute("FactionId",factionId); Profiles.IncrementStat(player,"FactionJoins",1) end
 StateRemote:FireClient(player,{kind="FactionJoined",name=f.name,motto=f.motto})
end
local function handleDaily(player:Player,promptObj:ProximityPrompt)
 if not validPlayer(player) or not proximity(player,promptObj.Parent,18) then return end
 local d=dailyChallenge(); local ok,status=Profiles.ClaimDaily(player,d.id,utcDate(),d.target,d.coins,d.xp)
 local data=Profiles.GetData(player)
 StateRemote:FireClient(player,{kind="DailyClaim",ok=ok,status=status,daily=dailyPayload(player),coins=data and data.Coins or 0,xp=data and data.XP or 0,level=data and data.Level or 1})
end
local function applyTownHall():any
 local counts=hallCounts(); local winner="TIE"; local high=-1; local leaders={}
 for _,side in ipairs({"A","B","C"}) do local n=counts[side] or 0; if n&gt;high then high=n; leaders={side} elseif n==high then table.insert(leaders,side) end end
 if #leaders&gt;0 then winner=leaders[random:NextInteger(1,#leaders)] end
 local idx=if winner=="A" then 1 elseif winner=="B" then 2 else 3
 local rule=Catalog.TownHallRules[idx]
 return {winner=winner,rule=rule,counts=counts}
end
function RoundService.AwardHype(player:Player,station:BasePart)
 if state.phase~="Rally" or not validPlayer(player) or not proximity(player,station,Config.Round.StationMaxDistance+2) then return end
 local char=player.Character; local hum=char and char:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health&lt;=0 then return end
 local t=os.clock(); if t-(lastChant[player.UserId] or 0)&lt;Config.Round.HypeCooldownSeconds then return end
 local n=hype[player.UserId] or 0; if n&gt;=Config.Round.MaxHypePerPlayer then return end
 local gain=if activeTownHallRule and activeTownHallRule.id=="double_hype" then 2 else 1
 local newValue=math.min(Config.Round.MaxHypePerPlayer,n+gain)
 lastChant[player.UserId]=t; hype[player.UserId]=newValue; chantActions[player.UserId]=(chantActions[player.UserId] or 0)+1
 StateRemote:FireClient(player,{kind="Hype",value=newValue,maximum=Config.Round.MaxHypePerPlayer})
end
function RoundService.Start(profileService:any,stateRemote:RemoteEvent,voteRemote:RemoteEvent,debateRemote:RemoteEvent,world:any,socialSystems:any?)
 Profiles=profileService; StateRemote=stateRemote; VoteRemote=voteRemote; DebateRemote=debateRemote; worldData=world
 VoteRemote.OnServerEvent:Connect(onCauseVote); DebateRemote.OnServerEvent:Connect(onDebateVote)
 for _,pr in ipairs(world.hype) do pr.Triggered:Connect(function(p) local parent=pr.Parent; if parent and parent:IsA("BasePart") then RoundService.AwardHype(p,parent) end end) end
 for _,entry in ipairs(world.shop) do entry.prompt.Triggered:Connect(function(p) handleShop(p,entry.itemId,entry.prompt) end) end
 for _,entry in ipairs(world.factions) do entry.prompt.Triggered:Connect(function(p) handleFaction(p,entry.factionId,entry.prompt) end) end
 for _,entry in ipairs(world.reactions) do entry.prompt.Triggered:Connect(function(p) onDebateReaction(p,entry.reactionId,entry.prompt) end) end
 world.townHallA.Triggered:Connect(function(p) if proximity(p,world.townHallA.Parent,16) then onTownHallVote(p,"A") end end)
 world.townHallB.Triggered:Connect(function(p) if proximity(p,world.townHallB.Parent,16) then onTownHallVote(p,"B") end end)
 world.townHallC.Triggered:Connect(function(p) if proximity(p,world.townHallC.Parent,16) then onTownHallVote(p,"C") end end)
 world.daily.Triggered:Connect(function(p) handleDaily(p,world.daily) end)
 local function bindPlayer(p:Player)
  if p:GetAttribute("PPRoundBound") then return end
  p:SetAttribute("PPRoundBound",true)
  p.CharacterAdded:Connect(function() task.wait(.5); local data=Profiles.GetData(p); if data then applyCosmetic(p,data.EquippedCosmetic) end end)
  task.spawn(function() local untilAt=os.clock()+Config.ProfileLoadTimeoutSeconds+5; while p.Parent==Players and not Profiles.IsLoaded(p) and os.clock()&lt;untilAt do task.wait(.2) end; if p.Parent==Players then sendProfile(p); local data=Profiles.GetData(p); if data and p.Character then applyCosmetic(p,data.EquippedCosmetic) end end end)
 end
 Players.PlayerAdded:Connect(bindPlayer)
 for _,existingPlayer in ipairs(Players:GetPlayers()) do bindPlayer(existingPlayer) end
 Players.PlayerRemoving:Connect(function(p) hype[p.UserId]=nil; chantActions[p.UserId]=nil; votes[p.UserId]=nil; debateVotes[p.UserId]=nil; hallVotes[p.UserId]=nil; reactionScores[p.UserId]=nil; lastChant[p.UserId]=nil; requestAt[p.UserId]=nil; requestAt["shop_"..p.UserId]=nil; requestAt["faction_"..p.UserId]=nil; requestAt["reaction_"..p.UserId]=nil end)
 task.spawn(function()
  while true do
   cause=nil; debate=nil; options={}; votes={}; debateVotes={}; hallVotes={}; hype={}; chantActions={}; reactionScores={}; reactionCounts={clap=0,laugh=0,sideeye=0}
   publish("Intermission",Config.Round.IntermissionSeconds,{heading="THE PLAZA IS OPEN",description=if activeTownHallRule then "CITY RULE ACTIVE: "..activeTownHallRule.title else "Four factions. One city. Absolutely no competent leadership."})
   task.wait(Config.Round.IntermissionSeconds)
   options=Catalog.GetRandomOptions(3,random); votes={}
   publish("Voting",Config.Round.VotingSeconds,{heading="WHAT ARE WE MAD ABOUT TODAY?",description="Vote for a fictional cause. Democracy has a megaphone.",options=options,voteCounts={}})
   task.wait(Config.Round.VotingSeconds); cause=chooseCause(); local scheduledDebate=if socialSystems and type(socialSystems.GetScheduledDebate)=="function" then socialSystems.GetScheduledDebate() else nil; debate=scheduledDebate or DebateCommunityService.GetNextPublicTopic() or Catalog.GetRandomDebate(random); debateVotes={}
   publish("Debate",Config.Round.DebateSeconds,{heading="THE PLAZA DEBATE",description="Debate the idea, never the person.",debate={id=debate.id,prompt=debate.prompt,sideA=debate.sideA,sideB=debate.sideB,context=debate.context},debateCounts={A=0,B=0},debateReactions=reactionCounts})
   task.wait(Config.Round.DebateSeconds); local debateWinner=chooseDebateWinner(); local debateMVP,debateMVPUserId=chooseDebateMVP(debateWinner)
   local alliances=createAlliances()
   publish("Rally",Config.Round.RallySeconds,{heading="THE RALLY IS LIVE",description="Lead chants, meet your faction, and watch the city get weird.",debateWinner=debateWinner,debateMVP=debateMVP,debateReactions=reactionCounts,crowdEvent=nil,alliances=alliances})
   local event=Catalog.CrowdEvents[random:NextInteger(1,#Catalog.CrowdEvents)]
   task.delay(math.max(8,Config.Round.RallySeconds*.35),function() if state.phase=="Rally" then WorldBuilder.ShowCrowdEvent(worldData,event); state.crowdEvent={id=event.id,title=event.title,detail=event.detail,endsAt=now()+event.duration}; StateRemote:FireAllClients(state); task.delay(event.duration,function() if state.phase=="Rally" then WorldBuilder.ClearCrowdEvent(worldData); state.crowdEvent=nil; StateRemote:FireAllClients(state) end end) end end)
   task.delay(math.max(12,Config.Round.RallySeconds*.62),function()
    if state.phase=="Rally" then
     local factions=Catalog.Factions; local traitor=factions[random:NextInteger(1,#factions)]; local old=factionAlliance[traitor.id] or "A"; local newSide=if old=="A" then "B" else "A"
     factionAlliance[traitor.id]=newSide
     state.betrayal={faction=traitor.name,from=allianceNames[old],to=allianceNames[newSide]}; StateRemote:FireAllClients(state)
    end
   end)
   task.wait(Config.Round.RallySeconds)
   WorldBuilder.ClearCrowdEvent(worldData)
   local rewards,factionLeader,allianceLeader,factionTotals=rewardParticipants(debateWinner,debateMVPUserId)
   if socialSystems and type(socialSystems.OnRoundResults)=="function" then socialSystems.OnRoundResults(factionTotals,debateMVPUserId,debateWinner,debate and debate.prompt or nil,debate and debate.id or nil,debateVotes) end
   WorldBuilder.ApplyConsequence(worldData,cause)
   publish("Results",Config.Round.ResultsSeconds,{heading="THE PLAZA HAS SPOKEN",description=cause.title,rewards=rewards,debateWinner=debateWinner,debateMVP=debateMVP,factionLeader=factionLeader,allianceLeader=allianceLeader})
   task.wait(Config.Round.ResultsSeconds)
   hallVotes={}; publish("TownHall",Config.Round.TownHallSeconds,{heading="TOWN HALL: CHANGE THE CITY",description="A: DOUBLE HYPE · B: PIGEON PARADE · C: CONFETTI BREAK. Use the three voting pads.",townHallOptions=Catalog.TownHallRules,townHallCounts={A=0,B=0,C=0}})
   task.wait(Config.Round.TownHallSeconds); local outcome=applyTownHall()
   activeTownHallRule=outcome.rule
   WorldBuilder.ApplyTownHallRule(worldData,outcome.rule)
   publish("TownHallResults",6,{heading="THE CITY HAS A NEW RULE",description=outcome.rule.title,townHallWinner=outcome.winner,townHallRule=outcome.rule,townHallCounts=outcome.counts})
   task.wait(6)
  end
 end)
end
return RoundService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">SocialSystemsService</string>
            <ProtectedString name="Source">--!strict
-- v0.8 integrated social layer. Server-authoritative; all durable writes are guarded and bounded.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local MessagingService = game:GetService("MessagingService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ContentCatalog"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local Service = {}
local IdentityStore = DataStoreService:GetDataStore("PP_SocialIdentity_v1")
local WarStore = DataStoreService:GetDataStore("PP_FactionWar_v1")
local CaseStore = DataStoreService:GetDataStore("PP_ModerationCases_v1")
local PartyReputationStore = DataStoreService:GetDataStore("PP_PartyReputation_v1")
local PredictionMap = MemoryStoreService:GetHashMap("PP_EventPredictions_v1")
local remote: RemoteEvent
local stateRemote: RemoteEvent
local partyService: any
local identityCache: {[number]: any} = {}
local identityCacheAt: {[number]: number} = {}
local requestAt: {[number]: number} = {}
local activeChallenges: {[string]: any} = {}
local warCache: any = nil
local warCacheAt = 0
local MAX_NOTE = 240
local MAX_REASON = 180
local function utcDay(): number return tonumber(os.date("!%w")) or 0 end
local function weekStartTimestamp(): number local now=os.time(); local dayStart=math.floor(now/86400)*86400; return dayStart-((utcDay()+6)%7)*86400 end
local function weekKey(): string return os.date("!%Y_W%W",weekStartTimestamp()) end
local function factionScoreStore() return DataStoreService:GetOrderedDataStore("PP_FactionWarScores_"..weekKey()) end
local function safeString(v: any, max: number): string? if type(v) ~= "string" then return nil end; local s=string.gsub(v,"[%c]"," "); s=string.sub(s,1,max); if string.match(s,"%S") == nil then return nil end; return s end
local function valid(player: Player): boolean return player.Parent==Players and player:GetAttribute("ProfileLoaded")==true end
local function moderator(player: Player): boolean for _,id in ipairs(Config.ModeratorUserIds or {}) do if id==player.UserId then return true end end; return false end
local function throttle(player: Player, key: string, seconds: number): boolean local k=key..":"..player.UserId; local t=os.clock(); if t-(requestAt[k] or 0)&lt;seconds then return false end; requestAt[k]=t; return true end
local function send(player: Player, kind: string, data: any) remote:FireClient(player,kind,data) end
local function defaultIdentity(userId: number): any return {userId=userId,title="New Voice",bio="",badges={},achievements={},reputation=0,history={},updatedAt=os.time()} end
local function identity(userId: number): any
 if identityCache[userId] and os.clock()-(identityCacheAt[userId] or 0)&lt;30 then return identityCache[userId] end
 local ok,data=pcall(function() return IdentityStore:GetAsync("u:"..userId) end)
 local value=if ok and type(data)=="table" then data else defaultIdentity(userId)
 value.userId=userId; value.badges=if type(value.badges)=="table" then value.badges else {}; value.achievements=if type(value.achievements)=="table" then value.achievements else {}; value.history=if type(value.history)=="table" then value.history else {}
 if ok then identityCache[userId]=value; identityCacheAt[userId]=os.clock() end
 return value
end
local function mutateIdentity(userId: number, callback: (any)-&gt;())
 local ok,result=pcall(function() return IdentityStore:UpdateAsync("u:"..userId,function(old)
  local data=if type(old)=="table" then old else defaultIdentity(userId); data.badges=if type(data.badges)=="table" then data.badges else {}; data.achievements=if type(data.achievements)=="table" then data.achievements else {}; data.history=if type(data.history)=="table" then data.history else {}; callback(data); data.userId=userId; data.updatedAt=os.time(); return data
 end) end)
 if ok and type(result)=="table" then identityCache[userId]=result; identityCacheAt[userId]=os.clock(); return true,result end
 warn("[SocialSystems] Identity persistence failed for "..userId..": "..tostring(result)); return false,nil
end
local function addHistory(data: any, event: string, amount: number)
 table.insert(data.history,1,{event=event,amount=amount,at=os.time()}); while #data.history&gt;20 do table.remove(data.history) end
end
local function getParty(player: Player): any?
 if not partyService or type(partyService.GetPartySnapshot)~="function" then return nil end
 return partyService.GetPartySnapshot(player)
end
local function partyMembers(player: Player): {Player}
 local result={}; local snap=getParty(player); if not snap or type(snap.members)~="table" then return result end
 for _,member in ipairs(snap.members) do local p=Players:GetPlayerByUserId(member.userId); if p then table.insert(result,p) end end
 return result
end
local function filteredText(player: Player, raw: string): string?
 local ok,filter=pcall(function() return TextService:FilterStringAsync(raw,player.UserId) end); if not ok or not filter then return nil end
 local success,text=pcall(function() return filter:GetNonChatStringForBroadcastAsync() end); if not success then return nil end
 return text
end
local function currentEvent(): any
 local now=os.time(); local dayStart=math.floor(now/86400)*86400
 -- Daily global debate window: 18:00 UTC, with a 30-minute prediction window.
 local starts=dayStart+18*3600
 local eventId="global:"..os.date("!%Y%m%d",starts)
 return {id=eventId,title="THE DAILY GLOBAL DEBATE",startsAt=starts,endsAt=starts+2*3600,predictionClosesAt=starts+1800,phase=if now&lt;starts then "UPCOMING" elseif now&lt;starts+2*3600 then "LIVE WINDOW" else "COMPLETE"}
end
local SCHEDULED_DEBATES={
 {prompt="Should pigeons receive formal voting rights in the city council?",sideA="YES: GIVE THE BIRDS A BALLOT",sideB="NO: THEY ALREADY CONTROL THE ROOFS",context="The city is reviewing representation after a pigeon repeatedly won an unopposed rooftop election."},
 {prompt="Should every printer be required to explain its paper jams?",sideA="YES: ACCOUNTABILITY FOR ALL MACHINES",sideB="NO: THE JAM IS A PRIVATE MATTER",context="A printer has jammed during a live council meeting and refuses to provide a statement."},
 {prompt="Should the city replace all queues with a single enormous queue?",sideA="YES: ONE QUEUE TO RULE THEM ALL",sideB="NO: KEEP THE QUEUES SEPARATE",context="The Department of Unnecessary Rules claims one queue would simplify every queue-related process."},
 {prompt="Should the last slice of pizza be decided by public referendum?",sideA="YES: LET THE PEOPLE DECIDE",sideB="NO: THE SLICE HAS ALREADY CHOSEN ME",context="A heated dispute over the final slice has delayed the weekly town hall."},
 {prompt="Should all city announcements be delivered by dramatic trumpet?",sideA="YES: MAKE EVERY UPDATE LEGENDARY",sideB="NO: PLEASE USE A NORMAL VOICE",context="The mayor's new announcement system has caused three false emergencies and one standing ovation."},
 {prompt="Should umbrellas be licensed before they are allowed indoors?",sideA="YES: REGULATE THE DRIP",sideB="NO: LET UMBRELLAS LIVE",context="A suspiciously large umbrella has been accused of blocking the entire recreation zone."},
 {prompt="Should the city introduce a four-day weekend every week?",sideA="YES: THIS IS BASIC CIVIC PROGRESS",sideB="NO: WE WOULD NEVER FINISH THE FORMS",context="The council must decide whether productivity can survive a permanent long weekend."},
}
local function defaultWarState(): any
 local factions={}; for _,f in ipairs(Catalog.Factions) do table.insert(factions,f.id) end
 local weekStart=weekStartTimestamp()
 local semifinalAt=weekStart+2*86400+18*3600; local finalAt=weekStart+4*86400+18*3600
 return {week=weekKey(),territories={},bracket={phase="SEMIFINALS",fixtures={{a=factions[1],b=factions[2],winner=nil},{a=factions[3],b=factions[4],winner=nil}},final=nil,semifinalAt=semifinalAt,finalAt=finalAt,finalSchedule="FRIDAY 18:00 UTC"},lastUpdated=os.time()}
end
local function readBracketState(): (any, boolean)
 local ok,data=pcall(function() return WarStore:GetAsync("week:"..weekKey()) end)
 if ok and type(data)=="table" then
  data.bracket=if type(data.bracket)=="table" then data.bracket else defaultWarState().bracket
  local defaults=defaultWarState().bracket; data.bracket.finalAt=data.bracket.finalAt or defaults.finalAt; data.bracket.semifinalAt=data.bracket.semifinalAt or defaults.semifinalAt; data.bracket.finalSchedule=data.bracket.finalSchedule or defaults.finalSchedule
  data.territories=if type(data.territories)=="table" then data.territories else {}
  return data,true
 end
 if ok then return defaultWarState(),true end
 return defaultWarState(),false
end
local function readFactionScores(): ({[string]: number}, boolean)
 local scores={}
 local ok,pages=pcall(function() return factionScoreStore():GetSortedAsync(false,4) end)
 if not ok or not pages then return scores,false end
 for _,entry in ipairs(pages:GetCurrentPage()) do scores[tostring(entry.key)]=tonumber(entry.value) or 0 end
 for _,f in ipairs(Catalog.Factions) do if scores[f.id]==nil then scores[f.id]=0 end end
 return scores,true
end
local function getWarState(): any
 if warCache and warCache.week==weekKey() and os.clock()-warCacheAt&lt;5 then return warCache end
 local data,bracketAvailable=readBracketState(); local scores,scoresAvailable=readFactionScores(); data.scores=scores; data.bracketAvailable=bracketAvailable; data.scoresAvailable=scoresAvailable; warCache=data; warCacheAt=os.clock(); return data
end
local function saveWar(callback: (any)-&gt;())
 local ok,result=pcall(function() return WarStore:UpdateAsync("week:"..weekKey(),function(old)
  local data=if type(old)=="table" then old else defaultWarState(); callback(data); data.week=weekKey(); data.lastUpdated=os.time(); return data
 end) end)
 if not ok then warn("[SocialSystems] War bracket write failed: "..tostring(result)); warCache=nil; return nil end
 warCache=nil; return result
end
local function publicWar(): any
 local data=getWarState(); local rows={}; for _,f in ipairs(Catalog.Factions) do table.insert(rows,{id=f.id,name=f.name,score=tonumber(data.scores and data.scores[f.id]) or 0,territory=(data.territories and data.territories[f.id])==true}) end
 table.sort(rows,function(a,b) return a.score&gt;b.score end)
 return {week=weekKey(),factions=rows,bracket=data.bracket,territories=data.territories or {},trophy=data.trophy,scoresAvailable=data.scoresAvailable==true,bracketAvailable=data.bracketAvailable==true}
end
local function createCase(player: Player, targetUserId: number, rawReason: string): string?
 local reason=filteredText(player,rawReason); if not reason then return nil end
 local caseId="case_"..HttpService:GenerateGUID(false)
 local case={id=caseId,reporter=player.UserId,target=targetUserId,reason=reason,status="OPEN",assignedTo=nil,notes={},appeals={},audit={{actor=player.UserId,action="CASE_CREATED",at=os.time()}},createdAt=os.time(),updatedAt=os.time()}
 local ok,err=pcall(function() CaseStore:SetAsync(caseId,case) end); if not ok then warn("[SocialSystems] Case creation failed: "..tostring(err)); return nil end
 return caseId
end
local function validCaseId(value: any): boolean return type(value)=="string" and #value&lt;=48 and string.sub(value,1,5)=="case_" end
local function getCase(caseId: string): any?
 local ok,data=pcall(function() return CaseStore:GetAsync(caseId) end); return if ok and type(data)=="table" then data else nil
end
local function updateCase(caseId: string, actorId: number, action: string, callback: (any)-&gt;boolean): (boolean, any?)
 local operationId=HttpService:GenerateGUID(false)
 local ok,result=pcall(function() return CaseStore:UpdateAsync(caseId,function(old)
  if type(old)~="table" then return nil end
  if not callback(old) then return old end
  old.audit=old.audit or {}; table.insert(old.audit,{id=operationId,actor=actorId,action=action,at=os.time()}); while #old.audit&gt;40 do table.remove(old.audit,1) end
  old.updatedAt=os.time(); return old
 end) end)
 local applied=false
 if ok and type(result)=="table" and type(result.audit)=="table" then for _,entry in ipairs(result.audit) do if entry.id==operationId then applied=true; break end end end
 return ok and applied,result
end
local function pushCaseDashboard(player: Player)
 if not moderator(player) then return end
 local queue={}; -- bounded known case IDs are indexed by MemoryStore for operational review.
 local map=MemoryStoreService:GetSortedMap("PP_ModerationCaseQueue_v1")
 local ok,pages=pcall(function() return map:GetRangeAsync(Enum.SortDirection.Descending,30) end)
 if ok and pages then for _,entry in ipairs(pages) do local case=getCase(tostring(entry.key)); if case then table.insert(queue,case) end end end
 send(player,"StaffDashboard",{cases=queue,available=ok,moderators=Config.ModeratorUserIds or {}})
end
local function queueCase(caseId: string): boolean
 local ok,err=pcall(function() MemoryStoreService:GetSortedMap("PP_ModerationCaseQueue_v1"):SetAsync(caseId,os.time(),7*86400) end)
 if not ok then warn("[SocialSystems] Case queue indexing failed for "..caseId..": "..tostring(err)) end
 return ok
end
local function onPartyAction(player: Player, action: string)
 local snap=getParty(player); if not snap then send(player,"Notice","Create or join a party first."); return end
 local members=partyMembers(player); local key=tostring(snap.partyId); local challenge=activeChallenges[key]
 if action=="StartPartyProtest" then
  if snap.leader~=player.UserId then send(player,"Notice","Only the party leader can start a coordinated protest."); return end
  if #members&lt;2 then send(player,"Notice","Invite at least one other player to your party."); return end
  if challenge and challenge.expiresAt&gt;os.time() then send(player,"Notice","Your party already has an active challenge."); return end
  local clubId=tostring(snap.clubId or snap.partyId); local token=HttpService:GenerateGUID(false)
  local reserved,record=pcall(function() return PartyReputationStore:UpdateAsync(clubId,function(old) local data=if type(old)=="table" then old else {reputation=tonumber(old) or 0,lastChallengeAt=0}; if os.time()-(tonumber(data.lastChallengeAt) or 0)&lt;300 then return data end; data.lastChallengeAt=os.time(); data.lastChallengeToken=token; return data end) end)
  if not reserved or type(record)~="table" or record.lastChallengeToken~=token then send(player,"Notice","Your party protest challenge is on cooldown or persistence is unavailable."); return end
  activeChallenges[key]={expiresAt=os.time()+120,joined={},partyId=key,leader=player.UserId,completed=false}
  for _,member in ipairs(members) do send(member,"PartyChallenge",{title="COORDINATED PROTEST",detail="Gather with your party and join the rally within 2 minutes.",expiresAt=os.time()+120}) end
 elseif action=="JoinPartyProtest" then
  if not challenge or challenge.expiresAt&lt;os.time() or challenge.completed then send(player,"Notice","No active party protest."); return end
  local char=player.Character; local root=char and char:FindFirstChild("HumanoidRootPart"); local leader=Players:GetPlayerByUserId(challenge.leader); local lchar=leader and leader.Character; local lroot=lchar and lchar:FindFirstChild("HumanoidRootPart")
  if not root or not lroot or (root.Position-lroot.Position).Magnitude&gt;70 then send(player,"Notice","Move within 70 studs of your party leader."); return end
  challenge.joined[player.UserId]=true
  local joined=0; for _,member in ipairs(members) do if challenge.joined[member.UserId] then joined+=1 end end
  send(player,"Notice","You joined the coordinated protest ("..joined.."/"..#members.." party members).")
  if joined&gt;=#members and not challenge.completed then
   challenge.completed=true; activeChallenges[key]=nil
   for _,member in ipairs(members) do
    local ok,data=mutateIdentity(member.UserId,function(profile) profile.reputation=math.min(100000,(tonumber(profile.reputation) or 0)+5); if not table.find(profile.achievements,"coordinated_protest") then table.insert(profile.achievements,"coordinated_protest") end; if member.UserId==snap.leader and not table.find(profile.badges,"party_captain") then table.insert(profile.badges,"party_captain"); if not table.find(profile.achievements,"party_captain") then table.insert(profile.achievements,"party_captain") end end; addHistory(profile,"Coordinated party protest",5) end)
    if ok then send(member,"PartyAchievement",{name="THE POWER OF NO",reputation=5}) end
   end
   local clubId=tostring(snap.clubId or snap.partyId); local clubOk,clubValue=pcall(function() return PartyReputationStore:UpdateAsync(clubId,function(old) local data=if type(old)=="table" then old else {reputation=tonumber(old) or 0,lastChallengeAt=0}; data.reputation=(tonumber(data.reputation) or 0)+5; return data end) end)
   local faction=player:GetAttribute("FactionId"); if type(faction)=="string" and Catalog.GetFaction(faction) then local scoreOk,scoreErr=pcall(function() factionScoreStore():IncrementAsync(faction,10) end); if not scoreOk then warn("[SocialSystems] Party faction score failed: "..tostring(scoreErr)) end; warCache=nil end
   stateRemote:FireAllClients({kind="WorldNotice",text="A coordinated protest has shaken the plaza. The factions are watching. Party reputation: "..tostring(if clubOk and type(clubValue)=="table" then clubValue.reputation else "unavailable")})
  end
 end
end
local function awardBadge(userId: number, badgeId: string, title: string, reputation: number)
 local cached=identityCache[userId]; if cached and table.find(cached.badges,badgeId) then return end
 mutateIdentity(userId,function(profile)
  if table.find(profile.badges,badgeId) then return end
  profile.reputation=math.min(100000,(tonumber(profile.reputation) or 0)+reputation)
  table.insert(profile.badges,badgeId)
  if not table.find(profile.achievements,title) then table.insert(profile.achievements,title) end
  addHistory(profile,title,reputation)
 end)
end
function Service.RefreshTournamentSchedule(): boolean
 local snapshot=getWarState(); local bracket=snapshot.bracket or defaultWarState().bracket
 if snapshot.bracketAvailable~=true or snapshot.scoresAvailable~=true or bracket.phase~="SEMIFINALS" then return false end
 local day=utcDay(); local hour=tonumber(os.date("!%H")) or 0
 if not (day&gt;3 or (day==3 and hour&gt;=18)) then return false end
 local winners={}
 for _,fixture in ipairs(bracket.fixtures or {}) do table.insert(winners,if (snapshot.scores[fixture.a] or 0)&gt;=(snapshot.scores[fixture.b] or 0) then fixture.a else fixture.b) end
 if #winners~=2 then return false end
 local saved=saveWar(function(data)
  data.bracket=data.bracket or defaultWarState().bracket
  if data.bracket.phase=="SEMIFINALS" then
   for index,fixture in ipairs(data.bracket.fixtures or {}) do fixture.winner=winners[index] end
   data.bracket.phase="FINAL"; data.bracket.final={a=winners[1],b=winners[2],winner=nil}
  end
 end)
 return saved~=nil
end
local function broadcastGlobalEventResult(eventData: any)
 if type(eventData)~="table" or not eventData.eventId then return end
 local marker=MemoryStoreService:GetHashMap("PP_GlobalEventMarkers_v1"); local token=HttpService:GenerateGUID(false); local key="broadcast:"..eventData.eventId
 local claimed,result=pcall(function() return marker:UpdateAsync(key,function(old) if old then return old end; return token end,24*3600) end)
 if not claimed or result~=token then return end
 local mvpPlayer=eventData.mvpUserId and Players:GetPlayerByUserId(eventData.mvpUserId)
 local message={eventId=eventData.eventId,winner=eventData.result,mvpUserId=eventData.mvpUserId,mvpName=if mvpPlayer then mvpPlayer.DisplayName else "Audience MVP",topic=eventData.topic,debateId=eventData.debateId}
 stateRemote:FireAllClients({kind="ChampionshipBroadcast",data=message})
 local published=false
 for attempt=1,3 do published=pcall(function() MessagingService:PublishAsync("PP_GlobalDebateBroadcast_v1",message) end); if published then break end; task.wait(2) end
 if not published then pcall(function() marker:RemoveAsync(key) end); warn("[SocialSystems] Global debate result saved but cross-server broadcast could not be delivered for "..tostring(eventData.eventId)) end
end
local function recordGlobalEventResult(event: any, debateWinner: string?, debateMVPUserId: number?, topicPrompt: string?, debateId: string?, debateParticipants: {[number]: string}?): any?
 if debateWinner~="A" and debateWinner~="B" and debateWinner~="TIE" then return nil end
 if os.time()&lt;event.startsAt or os.time()&gt;event.endsAt+600 then
  local readOk,existing=pcall(function() return PredictionMap:GetAsync(event.id) end)
  if readOk and type(existing)=="table" and existing.result then existing.eventId=event.id; task.spawn(broadcastGlobalEventResult,existing); return existing end
  return nil
 end
 local marker=MemoryStoreService:GetHashMap("PP_GlobalEventMarkers_v1"); local token=HttpService:GenerateGUID(false)
 local claimed,result=pcall(function() return marker:UpdateAsync("result:"..event.id,function(old) if old then return old end; return token end,24*3600) end)
 if not claimed then return nil end
 local eventData=nil
 if result==token then
  local saved,updated=pcall(function() return PredictionMap:UpdateAsync(event.id,function(old)
   local data=if type(old)=="table" then old else {votes={}}
   data.votes=data.votes or {}; local excluded=0
   for userId in pairs(debateParticipants or {}) do if data.votes[tostring(userId)] then data.votes[tostring(userId)]=nil; excluded+=1 end end
   data.A=0; data.B=0; for _,side in pairs(data.votes) do if side=="A" then data.A+=1 elseif side=="B" then data.B+=1 end end
   data.excludedParticipants=excluded
   data.result=debateWinner; data.resultAt=os.time(); data.mvpUserId=debateMVPUserId; data.topic=topicPrompt or "A global debate concluded."; data.debateId=debateId
   return data
  end,24*3600) end)
  if not saved then pcall(function() marker:RemoveAsync("result:"..event.id) end); return nil end
  eventData=updated
 else
  for attempt=1,3 do
   local readOk,existing=pcall(function() return PredictionMap:GetAsync(event.id) end)
   if readOk and type(existing)=="table" and existing.result then eventData=existing; break end
   task.wait(.25)
  end
 end
 if eventData then eventData.eventId=event.id; task.spawn(broadcastGlobalEventResult,eventData) end
 return eventData
end
function Service.OnRoundResults(factionPoints: {[string]: number}, debateMVPUserId: number?, debateWinner: string?, topicPrompt: string?, debateId: string?, debateParticipants: {[number]: string}?)
 for faction,points in pairs(factionPoints) do
  if type(faction)=="string" and Catalog.GetFaction(faction) and type(points)=="number" and points&gt;0 then
   local scoreOk,scoreErr=pcall(function() factionScoreStore():IncrementAsync(faction,math.clamp(math.floor(points),0,100)) end)
   if not scoreOk then warn("[SocialSystems] Faction score failed for "..faction..": "..tostring(scoreErr)) end
  end
 end
 warCache=nil
 Service.RefreshTournamentSchedule()
 local event=currentEvent(); local eventResult=recordGlobalEventResult(event,debateWinner,debateMVPUserId,topicPrompt,debateId,debateParticipants)
 if eventResult and type(eventResult.votes)=="table" and (eventResult.result=="A" or eventResult.result=="B") then for _,candidate in ipairs(Players:GetPlayers()) do if eventResult.votes[tostring(candidate.UserId)]==eventResult.result then task.spawn(awardBadge,candidate.UserId,"oracle_predictor","Civic Oracle",3) end end end
 local snapshot=getWarState(); local bracket=snapshot.bracket or defaultWarState().bracket
 local day=utcDay(); local hour=tonumber(os.date("!%H")) or 0
 local finalDue=(day&gt;5 or (day==5 and hour&gt;=18))
 if snapshot.bracketAvailable==true and finalDue and bracket.phase=="FINAL" and bracket.final and debateId=="factionfinal:"..weekKey() and eventResult and eventResult.debateId=="factionfinal:"..weekKey() then
  local finalistA,finalistB=bracket.final.a,bracket.final.b
  local canonicalWinner=eventResult.result
  local finalWinner=if canonicalWinner=="A" then finalistA elseif canonicalWinner=="B" then finalistB elseif snapshot.scoresAvailable and (snapshot.scores[finalistA] or 0)&gt;=(snapshot.scores[finalistB] or 0) then finalistA elseif snapshot.scoresAvailable then finalistB else nil
  if finalWinner then saveWar(function(data)
   data.bracket=data.bracket or defaultWarState().bracket
   if data.bracket.phase=="FINAL" and data.bracket.final then data.bracket.final.winner=finalWinner; data.bracket.phase="COMPLETE"; data.territories={}; data.territories[finalWinner]=true; data.trophy={faction=finalWinner,week=weekKey(),awardedAt=os.time(),finalDebateId=debateId,eventId=event.id} end
  end) end
 end
 if debateMVPUserId then awardBadge(debateMVPUserId,"audience_mvp","Audience MVP",10) end
 local war=publicWar(); stateRemote:FireAllClients({kind="FactionWarUpdate",data=war})
 if war.bracket and war.bracket.phase=="COMPLETE" and war.bracket.final and war.bracket.final.winner then
  local winner=war.bracket.final.winner; local winnerFaction=Catalog.GetFaction(winner); local winnerName=if winnerFaction then winnerFaction.name else winner
  for _,p in ipairs(Players:GetPlayers()) do if p:GetAttribute("FactionId")==winner then awardBadge(p.UserId,"faction_champion","Faction Champion",15) end end
  local marker=MemoryStoreService:GetHashMap("PP_GlobalEventMarkers_v1"); local token=HttpService:GenerateGUID(false)
  local claimed,claimResult=pcall(function() return marker:UpdateAsync("faction:"..war.week,function(old) if old then return old end; return token end,14*86400) end)
  if claimed and claimResult==token then
   stateRemote:FireAllClients({kind="ChampionshipBroadcast",data={title="FACTION WAR CHAMPIONS",winner=winnerName,trophy=war.trophy}})
   local published=pcall(function() MessagingService:PublishAsync("PP_SocialWorldUpdate_v1",{kind="TERRITORY",week=war.week,winner=winnerName}) end)
   if not published then pcall(function() marker:RemoveAsync("faction:"..war.week) end) end
  end
 end
 Service.ApplyWorldEvolution()
end
function Service.GetWarState(): any
 Service.RefreshTournamentSchedule()
 return publicWar()
end
function Service.GetEventPreview(): any
 Service.RefreshTournamentSchedule()
 local event=currentEvent(); local war=publicWar(); local bracket=war.bracket
 local finalIsScheduled=bracket and bracket.phase=="FINAL" and bracket.final and bracket.finalAt and event.startsAt&gt;=bracket.finalAt and war.bracketAvailable
 local finalAlreadyPlayed=bracket and bracket.phase=="COMPLETE" and bracket.final and war.trophy and war.trophy.eventId==event.id
 if bracket and bracket.final and (finalIsScheduled or finalAlreadyPlayed) and war.bracketAvailable then
  local finalistA,finalistB=bracket.final.a,bracket.final.b
  local factionA=finalistA and Catalog.GetFaction(finalistA); local factionB=finalistB and Catalog.GetFaction(finalistB)
  if factionA and factionB then return {id="factionfinal:"..weekKey(),prompt="Which faction deserves control of the plaza this week?",sideA=factionA.name,sideB=factionB.name,context="The semifinal winners face off in the scheduled Faction War final. The winning side claims the plaza territory and the weekly trophy.",category="Faction War Final",eventId=event.id} end
 end
 local dayOfYear=tonumber(os.date("!%j",event.startsAt)) or 1; local topic=SCHEDULED_DEBATES[((dayOfYear-1)%#SCHEDULED_DEBATES)+1]
 return {id=event.id,prompt=topic.prompt,sideA=topic.sideA,sideB=topic.sideB,context=topic.context,category="Global Event"}
end
function Service.GetScheduledDebate(): any?
 local event=currentEvent(); local now=os.time()
 if now&lt;event.startsAt or now&gt;event.endsAt then return nil end
 return Service.GetEventPreview()
end
function Service.ApplyWorldEvolution()
 local war=publicWar(); if not war.bracketAvailable then return end; local folder=workspace:FindFirstChild("ProtestPartyWorld"); if not folder then return end
 local owner=nil; for _,f in ipairs(war.factions) do if f.territory then owner=f.id end end
 local plaza=folder:FindFirstChild("PlazaTerritoryBanner")
 if not plaza then local p=Instance.new("Part"); p.Name="PlazaTerritoryBanner"; p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.Size=Vector3.new(18,.5,2); p.Position=Vector3.new(0,9,-71); p.Material=Enum.Material.Neon; p.Parent=folder; plaza=p end
 local factionColors={pigeon_union=Color3.fromRGB(160,160,170),printer_resistance=Color3.fromRGB(120,170,255),bureaucracy=Color3.fromRGB(190,150,90),snack_council=Color3.fromRGB(255,145,100)}
 if plaza:IsA("BasePart") then plaza.Color=if owner then factionColors[owner] or Config.UI.Accent else Config.UI.Accent end end
 local bannerGui=plaza:FindFirstChild("TerritoryLabel")
 if not bannerGui then local g=Instance.new("BillboardGui"); g.Name="TerritoryLabel"; g.Size=UDim2.fromOffset(300,46); g.StudsOffset=Vector3.new(0,2.5,0); g.AlwaysOnTop=true; g.MaxDistance=260; g.Parent=plaza; bannerGui=g; local l=Instance.new("TextLabel"); l.Name="Label"; l.Size=UDim2.fromScale(1,1); l.BackgroundTransparency=1; l.TextColor3=Color3.fromRGB(245,247,250); l.TextStrokeTransparency=.4; l.Font=Enum.Font.GothamBlack; l.TextScaled=true; l.Parent=g end
 local bannerText=bannerGui and bannerGui:FindFirstChild("Label"); if bannerText and bannerText:IsA("TextLabel") then bannerText.Text=if owner then string.upper(ownerName).." TERRITORY" else "UNCLAIMED PLAZA" end
 for i,f in ipairs(Catalog.Factions) do
  local flagName="TerritoryFlag_"..f.id; local flag=folder:FindFirstChild(flagName)
  if not flag then local p=Instance.new("Part"); p.Name=flagName; p.Size=Vector3.new(5,.4,1); p.Position=Vector3.new(-104+(i-1)*69,7,-120); p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.Parent=folder; flag=p end
  if flag:IsA("BasePart") then flag.Color=factionColors[f.id] or Config.UI.Accent; flag.Transparency=if owner==f.id then 0 else .72 end end
 end
 local trophy=folder:FindFirstChild("FactionWarTrophy")
 if not trophy then local t=Instance.new("Part"); t.Name="FactionWarTrophy"; t.Size=Vector3.new(2,5,2); t.Position=Vector3.new(0,3,-82); t.Anchored=true; t.CanCollide=false; t.CanTouch=false; t.Material=Enum.Material.Metal; t.Color=Color3.fromRGB(245,204,85); t.Parent=folder; trophy=t end
 if trophy:IsA("BasePart") then trophy.Transparency=if owner then 0 else 0.55 end
 local trophyGui=trophy:FindFirstChild("CupLabel")
 if not trophyGui then local g=Instance.new("BillboardGui"); g.Name="CupLabel"; g.Size=UDim2.fromOffset(220,54); g.StudsOffset=Vector3.new(0,3,0); g.AlwaysOnTop=true; g.Parent=trophy; trophyGui=g; local l=Instance.new("TextLabel"); l.Name="Label"; l.Size=UDim2.fromScale(1,1); l.BackgroundTransparency=1; l.TextColor3=Color3.fromRGB(255,230,150); l.Font=Enum.Font.GothamBlack; l.TextScaled=true; l.Parent=g end
 local trophyText=trophyGui and trophyGui:FindFirstChild("Label"); if trophyText and trophyText:IsA("TextLabel") then trophyText.Text=if owner then string.upper(ownerName).." WAR CHAMPIONS" else "FACTION WAR" end
 for _,npc in ipairs(folder:GetChildren()) do
  if string.sub(npc.Name,1,4)=="NPC_" then local head=npc:FindFirstChild("Head"); local gui=head and head:FindFirstChild("WorldLabel"); local subtitle=gui and gui:FindFirstChild("Subtitle"); if subtitle and subtitle:IsA("TextLabel") then npc:SetAttribute("TerritoryDialogue",if owner then "The "..tostring(owner).." faction currently holds the plaza." else "The plaza is awaiting its next champion." end) end end
 end
end
local function applyOverheadTitle(player: Player, title: string)
 local character=player.Character; local head=character and character:FindFirstChild("Head")
 if not head or not head:IsA("BasePart") then return end
 local old=head:FindFirstChild("SocialTitle"); if old then old:Destroy() end
 if title=="New Voice" then return end
 local gui=Instance.new("BillboardGui"); gui.Name="SocialTitle"; gui.Size=UDim2.fromOffset(180,28); gui.StudsOffset=Vector3.new(0,2.8,0); gui.AlwaysOnTop=true; gui.MaxDistance=65; gui.Parent=head
 local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.Text=string.upper(title); label.TextColor3=Config.UI.Accent; label.TextStrokeTransparency=.45; label.Font=Enum.Font.GothamBold; label.TextScaled=true; label.Parent=gui
end
function Service.Start(socialRemote: RemoteEvent, state: RemoteEvent, parties: any)
 remote=socialRemote; stateRemote=state; partyService=parties
 remote.OnServerEvent:Connect(function(player,action,value,extra)
  if type(action)~="string" or not valid(player) or not throttle(player,"social",0.45) then return end
  if action=="GetIdentity" then
   local target=player.UserId; if type(value)=="number" and value==value and value&gt;=1 and value&lt;=9007199254740991 then target=math.floor(value) end
   local profile=identity(target); local p=Players:GetPlayerByUserId(target)
   send(player,"PublicProfile",{userId=target,name=if p then p.DisplayName else "Player "..target,title=profile.title,bio=profile.bio,badges=profile.badges,achievements=profile.achievements,reputation=profile.reputation,history=profile.history})
  elseif action=="SetTitle" then
   if not throttle(player,"title",2) then return end
   local title=safeString(value,32); if not title then return end
   local profile=identity(player.UserId); local titleBadges={ ["New Voice"]=nil,["Audience MVP"]="audience_mvp",["Party Captain"]="party_captain",["Faction Champion"]="faction_champion",["Civic Oracle"]="oracle_predictor" }
   local required=titleBadges[title]
   if titleBadges[title]==nil and title~="New Voice" or (required and not table.find(profile.badges,required)) then send(player,"Notice","That title has not been unlocked."); return end
   local ok=mutateIdentity(player.UserId,function(data) data.title=title end); if ok then applyOverheadTitle(player,title) end; send(player,"Notice",if ok then "Title updated." else "Could not save title.")
  elseif action=="StartPartyProtest" or action=="JoinPartyProtest" then onPartyAction(player,action)
  elseif action=="GetWar" then send(player,"FactionWar",publicWar())
  elseif action=="GetParty" then
   if not throttle(player,"party_read",3) then return end
   local snap=getParty(player); if not snap then send(player,"Notice","You are not in a party."); return end
   local ok,record=pcall(function() return PartyReputationStore:GetAsync(tostring(snap.clubId or snap.partyId)) end)
   local reputation=if ok and type(record)=="table" then tonumber(record.reputation) or 0 elseif ok then tonumber(record) or 0 else 0
   send(player,"PartySummary",{party=snap,reputation=reputation,available=ok})
  elseif action=="SetBio" then
   if not throttle(player,"bio",30) then send(player,"Notice","Please wait before changing your bio again."); return end
   local bio=safeString(value,100); if not bio then return end
   local filtered=filteredText(player,bio); if not filtered then send(player,"Notice","Bio was rejected by text filtering."); return end
   local ok=mutateIdentity(player.UserId,function(profile) profile.bio=filtered end); send(player,"Notice",if ok then "Profile bio updated." else "Could not save bio.")
  elseif action=="GetEvent" then
   if not throttle(player,"event_read",5) then return end
   local event=currentEvent(); local ok,predictions=pcall(function() return PredictionMap:GetAsync(event.id) end)
   local summary={A=0,B=0,result=nil,myPrediction=nil}
   if ok and type(predictions)=="table" then summary.A=tonumber(predictions.A) or 0; summary.B=tonumber(predictions.B) or 0; summary.result=predictions.result; if type(predictions.votes)=="table" then summary.myPrediction=predictions.votes[tostring(player.UserId)] end end
   send(player,"GlobalEvent",{event=event,debate=Service.GetEventPreview(),predictions=summary,predictionsAvailable=ok})
  elseif action=="Predict" then
   local event=currentEvent(); if os.time()&gt;=event.predictionClosesAt or (value~="A" and value~="B") then send(player,"Notice","Predictions are closed or the selection is invalid."); return end
   local markerKey="vote:"..event.id..":"..tostring(player.UserId); local token=HttpService:GenerateGUID(false)
   local claimed,claimResult=pcall(function() return PredictionMap:UpdateAsync(markerKey,function(old) if old then return old end; return token end,24*3600) end)
   if not claimed or claimResult~=token then send(player,"Notice","You have already submitted a prediction for this event."); return end
   local ok,updated=pcall(function() return PredictionMap:UpdateAsync(event.id,function(old) local data=if type(old)=="table" then old else {votes={}}; data.votes=data.votes or {}; local count=0; for _ in pairs(data.votes) do count+=1 end; if data.votes[tostring(player.UserId)] or count&gt;=300 then return data end; data.votes[tostring(player.UserId)]=value; data.A=0; data.B=0; for _,side in pairs(data.votes) do if side=="A" then data.A+=1 elseif side=="B" then data.B+=1 end end; return data end,24*3600) end)
   local accepted=ok and type(updated)=="table" and type(updated.votes)=="table" and updated.votes[tostring(player.UserId)]==value
   if not accepted then pcall(function() PredictionMap:RemoveAsync(markerKey) end) end
   send(player,"Notice",if accepted then "Prediction recorded." elseif ok then "The event prediction limit has been reached." else "Prediction service is temporarily unavailable.")
  elseif action=="ReportPlayer" then
   if not throttle(player,"report",20) then send(player,"Notice","Please wait before submitting another report."); return end
   local target=tonumber(value); local reason=safeString(extra,MAX_REASON); if not target or target&lt;=0 or target%1~=0 or target==math.huge or target==-math.huge or target==player.UserId or not reason then return end
   local caseId=createCase(player,math.floor(target),reason); if caseId then local queued=queueCase(caseId); send(player,"Notice",if queued then "Report submitted. Case "..caseId else "Report saved but staff queue indexing is delayed. Save case ID: "..caseId) else send(player,"Notice","Report could not be submitted.") end
  elseif action=="GetStaffDashboard" then if moderator(player) and throttle(player,"staff_read",5) then pushCaseDashboard(player) end
  elseif action=="AssignCase" then
   if not throttle(player,"case_action",2) then return end
   if not moderator(player) or not validCaseId(value) or type(extra)~="number" or extra~=extra or extra&lt;1 or extra&gt;9007199254740991 or extra%1~=0 then return end
   local allowedAssignee=false; for _,uid in ipairs(Config.ModeratorUserIds or {}) do if uid==math.floor(extra) then allowedAssignee=true end end; if not allowedAssignee then return end
   local ok=updateCase(value,player.UserId,"ASSIGNED",function(case) if case.status=="RESOLVED" or case.status=="APPEAL_ACCEPTED" or case.status=="APPEAL_REJECTED" then return false end; case.assignedTo=math.floor(extra); if case.status=="OPEN" then case.status="IN_REVIEW" end; table.insert(case.notes,{by=player.UserId,text="Case assigned",at=os.time()}); return true end); send(player,"Notice",if ok then "Case assigned." else "Assignment failed."); pushCaseDashboard(player)
  elseif action=="AddCaseNote" then
   if not throttle(player,"case_action",2) then return end
   local note=safeString(extra,MAX_NOTE); if not moderator(player) or not validCaseId(value) or not note then return end
   local filtered=filteredText(player,note); if not filtered then return end
   local ok=updateCase(value,player.UserId,"NOTE_ADDED",function(case) table.insert(case.notes,{by=player.UserId,text=filtered,at=os.time()}); while #case.notes&gt;30 do table.remove(case.notes,1) end; return true end); send(player,"Notice",if ok then "Internal note saved." else "Note could not be saved."); pushCaseDashboard(player)
  elseif action=="ResolveCase" then
   if not throttle(player,"case_action",2) then return end
   if not moderator(player) or not validCaseId(value) then return end
   local ok=updateCase(value,player.UserId,"RESOLVED",function(case) if case.status~="OPEN" and case.status~="IN_REVIEW" then return false end; case.status="RESOLVED"; case.resolvedBy=player.UserId; case.resolvedAt=os.time(); return true end); send(player,"Notice",if ok then "Case resolved." else "Resolution failed."); pushCaseDashboard(player)
  elseif action=="DecideAppeal" then
   if not throttle(player,"case_action",2) then return end
   if not moderator(player) or not validCaseId(value) or type(extra)~="boolean" then return end
   local ok=updateCase(value,player.UserId,if extra then "APPEAL_ACCEPTED" else "APPEAL_REJECTED",function(case) if case.status~="APPEALED" then return false end; case.status=if extra then "APPEAL_ACCEPTED" else "APPEAL_REJECTED"; case.appealDecisionBy=player.UserId; case.appealDecisionAt=os.time(); local last=case.appeals and case.appeals[#case.appeals]; if last then last.status=if extra then "ACCEPTED" else "REJECTED" end; return true end); send(player,"Notice",if ok then "Appeal decision saved." else "Appeal decision failed."); pushCaseDashboard(player)
  elseif action=="AppealCase" then
   if not throttle(player,"appeal",10) then return end
   local appeal=safeString(extra,MAX_REASON); if not validCaseId(value) or not appeal then return end
   local filtered=filteredText(player,appeal); if not filtered then return end
   local ok=updateCase(value,player.UserId,"APPEAL_SUBMITTED",function(case) if case.target~=player.UserId or case.status~="RESOLVED" then return false end; case.appeals=case.appeals or {}; table.insert(case.appeals,{by=player.UserId,text=filtered,at=os.time(),status="OPEN"}); case.status="APPEALED"; return true end); local queued=if ok then queueCase(value) else false; send(player,"Notice",if ok and queued then "Appeal submitted for staff review." elseif ok then "Appeal saved but staff queue indexing is delayed." else "Appeal could not be submitted.")
  end
 end)
 local boundPlayers: {[number]: boolean} = {}
 local function bindPlayer(player: Player)
  if boundPlayers[player.UserId] then return end; boundPlayers[player.UserId]=true
  task.spawn(function()
   local deadline=os.clock()+120
   while player.Parent==Players and not valid(player) and os.clock()&lt;deadline do task.wait(.5) end
   if not valid(player) then boundPlayers[player.UserId]=nil; return end
   local profile=identity(player.UserId)
   send(player,"IdentitySummary",{title=profile.title,reputation=profile.reputation,badges=profile.badges})
   send(player,"GlobalEvent",{event=currentEvent(),debate=Service.GetEventPreview()})
   for offset=0,1 do
    local eventDate=os.date("!%Y%m%d",os.time()-offset*86400); local eventId="global:"..eventDate
    local eventOk,eventData=pcall(function() return PredictionMap:GetAsync(eventId) end)
    if eventOk and type(eventData)=="table" and eventData.result and eventData.votes and eventData.votes[tostring(player.UserId)]==eventData.result then task.spawn(awardBadge,player.UserId,"oracle_predictor","Civic Oracle",3) end
   end
   if player.Character then applyOverheadTitle(player,profile.title) end
   player.CharacterAdded:Connect(function() task.wait(.5); local latest=identity(player.UserId); applyOverheadTitle(player,latest.title) end)
  end)
 end
 Players.PlayerAdded:Connect(bindPlayer)
 Players.PlayerRemoving:Connect(function(player) boundPlayers[player.UserId]=nil; identityCache[player.UserId]=nil; identityCacheAt[player.UserId]=nil; for key in pairs(requestAt) do if string.find(key,":"..player.UserId,1,true) then requestAt[key]=nil end end end)
 for _,player in ipairs(Players:GetPlayers()) do bindPlayer(player) end
 pcall(function() MessagingService:SubscribeAsync("PP_SocialWorldUpdate_v1",function(message)
  local data=message.Data
  task.spawn(function()
   warCache=nil; Service.ApplyWorldEvolution(); stateRemote:FireAllClients({kind="FactionWarUpdate",data=publicWar()})
   if type(data)=="table" and data.kind=="TERRITORY" then
    stateRemote:FireAllClients({kind="ChampionshipBroadcast",data={title="FACTION WAR CHAMPIONS",winner=data.winner}})
    stateRemote:FireAllClients({kind="WorldNotice",text="The plaza territory has changed across the city."})
   end
  end)
 end) end)
 pcall(function() MessagingService:SubscribeAsync("PP_GlobalDebateBroadcast_v1",function(message)
  local data=message.Data
  if type(data)=="table" and data.eventId and (data.winner=="A" or data.winner=="B") then
   task.spawn(function()
    local ok,eventData=pcall(function() return PredictionMap:GetAsync(data.eventId) end)
    if ok and type(eventData)=="table" and type(eventData.votes)=="table" then
     for _,candidate in ipairs(Players:GetPlayers()) do if eventData.votes[tostring(candidate.UserId)]==data.winner then task.spawn(awardBadge,candidate.UserId,"oracle_predictor","Civic Oracle",3) end end
    end
   end)
  end
  stateRemote:FireAllClients({kind="ChampionshipBroadcast",data=data})
 end) end)
 task.spawn(function()
  while true do for key,challenge in pairs(activeChallenges) do if challenge.expiresAt&lt;os.time() then activeChallenges[key]=nil end end; task.wait(30) end
 end)
 task.spawn(function()
  while true do Service.RefreshTournamentSchedule(); task.wait(30) end
 end)
 task.spawn(function()
  local announced={}
  while true do
   local event=currentEvent()
   if os.time()&gt;=event.startsAt and os.time()&lt;event.endsAt and not announced[event.id] then
    announced[event.id]=true
    local marker=MemoryStoreService:GetHashMap("PP_GlobalEventMarkers_v1")
    local token=HttpService:GenerateGUID(false)
    local ok,result=pcall(function() return marker:UpdateAsync("start:"..event.id,function(old) if old then return old end; return token end,3*3600) end)
    if not ok then announced[event.id]=nil elseif result==token then local published=pcall(function() MessagingService:PublishAsync("PP_GlobalDebateBroadcast_v1",{eventId=event.id,announcement=true,title=event.title,startsAt=event.startsAt}) end); if not published then pcall(function() marker:RemoveAsync("start:"..event.id) end); announced[event.id]=nil end end
   end
   task.wait(15)
  end
 end)
 Service.ApplyWorldEvolution()
end
return Service
</ProtectedString>
          </Properties>
